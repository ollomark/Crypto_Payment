@{
    ViewBag.Title = "2FA Aktif Edildi";
    Layout = "_AuthLayout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card mt-4 card-bg-fill">
                <div class="card-body p-4">
                    <div class="text-center mt-2">
                        <i class="ri-checkbox-circle-line text-success" style="font-size: 64px;"></i>
                        <h5 class="text-primary mt-3">2FA Başarıyla Aktif Edildi</h5>
                        <p class="text-muted">İki faktörlü doğrulama hesabınız için aktif edildi.</p>
                    </div>

                    @if (TempData["RecoveryCodes"] != null)
                    {
                        <div class="mt-4">
                            <div class="alert alert-warning">
                                <h6 class="alert-heading"><i class="ri-error-warning-line me-1"></i> Kurtarma Kodları</h6>
                                <p class="mb-2">Bu kodları güvenli bir yere kaydedin. Authenticator uygulamanıza erişemezseniz bu kodlarla giriş yapabilirsiniz.</p>
                                <pre class="p-3 bg-light rounded mb-0">@TempData["RecoveryCodes"]</pre>
                            </div>
                        </div>
                    }

                    <div class="mt-4 text-center">
                        <a href="/" class="btn btn-primary">Ana Sayfaya Git</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
