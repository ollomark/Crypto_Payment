@{
    ViewBag.Title = "İki Faktörlü Doğrulama";
    Layout = "_AuthLayout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card mt-4 card-bg-fill">
                <div class="card-body p-4">
                    <div class="text-center mt-2">
                        <h5 class="text-primary">İki Faktörlü Doğrulama</h5>
                        <p class="text-muted">Authenticator uygulamanızdaki 6 haneli kodu girin.</p>
                    </div>
                    <div class="p-2 mt-4">
                        <form method="post" action="/api/auth/twofactor" id="twoFactorForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RememberMe" value="@(ViewData["RememberMe"] ?? false)" />
                            <input type="hidden" name="RememberClient" value="true" />

                            <div class="mb-3">
                                <label for="code" class="form-label">Doğrulama Kodu</label>
                                <input type="text" name="Code" class="form-control" id="code" placeholder="123456" required autofocus autocomplete="one-time-code" />
                            </div>

                            <div id="apiError" class="alert alert-danger d-none"></div>

                            <div class="mt-4">
                                <button class="btn btn-success w-100" type="submit">Doğrula</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
