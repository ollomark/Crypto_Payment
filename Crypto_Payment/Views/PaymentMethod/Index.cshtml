@{
    ViewBag.Title = "Ödeme Yöntemleri";
    Layout = "_Layout";
}

<div class="container-fluid">

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">Ödeme Yöntemleri</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                    <li class="breadcrumb-item active">Ödeme Yöntemleri</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Özet Kartları -->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Toplam Yöntem</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0" id="stat-total">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-primary-subtle rounded fs-3"><i class="ri-bank-card-line text-primary"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Aktif</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0 text-success" id="stat-active">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-success-subtle rounded fs-3"><i class="ri-checkbox-circle-line text-success"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Pasif</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0 text-danger" id="stat-inactive">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-danger-subtle rounded fs-3"><i class="ri-close-circle-line text-danger"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Varsayılan</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0 text-info" id="stat-default">-</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-info-subtle rounded fs-3"><i class="ri-star-line text-info"></i></span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ana Kart -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0 flex-grow-1"><i class="ri-secure-payment-line me-1"></i>Ödeme Yöntemleri</h5>
                    <button class="btn btn-primary btn-sm" onclick="openAddModal()"><i class="ri-add-line me-1"></i>Yeni Yöntem Ekle</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3" id="methodsContainer">
                    <div class="col-12 text-center py-4" id="loadingState">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span class="ms-2 text-muted">Yükleniyor...</span>
                    </div>
                </div>
                <div class="text-center py-5 d-none" id="emptyState">
                    <i class="ri-bank-card-line text-muted" style="font-size:56px;"></i>
                    <h5 class="mt-3">Henüz ödeme yöntemi eklenmemiş</h5>
                    <p class="text-muted">Yeni bir ödeme yöntemi ekleyerek başlayın.</p>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Ekle/Düzenle Modal -->
<div class="modal fade" id="methodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header" id="modalHeader">
                <h5 class="modal-title" id="modalTitle"><i class="ri-add-line me-2"></i>Yeni Ödeme Yöntemi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="methodForm" autocomplete="off">
                <div class="modal-body">
                    <input type="hidden" id="f-id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Yöntem Adı <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="f-name" placeholder="Ör: Plisio Kripto, Ziraat Bankası" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Tür <span class="text-danger">*</span></label>
                            <select id="f-type" class="form-select" onchange="onTypeChange()" required>
                                <option value="fast_crypto">Hızlı Kripto (TRX/USDT)</option>
                                <option value="plisio">Plisio (Kripto)</option>
                                <option value="bank_transfer">Banka Havalesi / EFT</option>
                                <option value="credit_card">Kredi Kartı</option>
                                <option value="crypto_wallet">Kripto Cüzdan (Manuel)</option>
                                <option value="manual">Manuel Ödeme</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Açıklama</label>
                            <input type="text" class="form-control" id="f-desc" placeholder="Kısa açıklama">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">İkon</label>
                            <div class="input-group">
                                <span class="input-group-text"><i id="iconPreview" class="ri-bank-card-line"></i></span>
                                <input type="text" class="form-control" id="f-icon" placeholder="ri-bank-card-line" oninput="previewIcon()">
                            </div>
                            <small class="text-muted">Remix Icon class adı</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Sıra</label>
                            <input type="number" class="form-control" id="f-sort" value="0" min="0">
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="f-active" checked>
                                <label class="form-check-label" for="f-active">Aktif</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="f-default">
                                <label class="form-check-label" for="f-default">Varsayılan</label>
                            </div>
                        </div>
                    </div>

                    <!-- Banka bilgileri -->
                    <div id="bankFields" class="d-none">
                        <hr class="my-3">
                        <h6 class="text-muted mb-3"><i class="ri-bank-line me-1"></i>Banka Bilgileri</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Banka Adı</label>
                                <input type="text" class="form-control" id="f-bankName" placeholder="Ör: Ziraat Bankası">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Hesap Sahibi</label>
                                <input type="text" class="form-control" id="f-accountHolder" placeholder="Ad Soyad / Şirket Adı">
                            </div>
                            <div class="col-12">
                                <label class="form-label">IBAN</label>
                                <input type="text" class="form-control" id="f-iban" placeholder="TR00 0000 0000 0000 0000 0000 00">
                            </div>
                        </div>
                    </div>

                    <!-- Tek cüzdan bilgileri (crypto_wallet) -->
                    <div id="singleWalletFields" class="d-none">
                        <hr class="my-3">
                        <h6 class="text-muted mb-3"><i class="ri-wallet-3-line me-1"></i>Cüzdan Bilgileri</h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Cüzdan Adresi</label>
                                <input type="text" class="form-control" id="f-walletAddress" placeholder="0x... / T...">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ağ (Network)</label>
                                <input type="text" class="form-control" id="f-walletNetwork" placeholder="TRC20, ERC20, BTC...">
                            </div>
                        </div>
                    </div>

                    <!-- Çoklu cüzdan (fast_crypto) -->
                    <div id="multiWalletFields" class="d-none">
                        <hr class="my-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="text-muted mb-0"><i class="ri-wallet-3-line me-1"></i>Cüzdanlar <span class="badge bg-primary-subtle text-primary ms-1 fs-10" id="walletCount">0</span></h6>
                            <button type="button" class="btn btn-sm btn-soft-primary" onclick="addWalletRow()"><i class="ri-add-line me-1"></i>Cüzdan Ekle</button>
                        </div>
                        <div class="alert alert-info-subtle border border-info-subtle fs-12 py-2 mb-3">
                            <i class="ri-information-line me-1 align-middle"></i>Birden fazla cüzdan ekleyebilirsiniz. Her ödeme isteğinde rastgele bir cüzdan seçilir.
                        </div>
                        <div id="walletList" class="vstack gap-2"></div>
                    </div>

                    <div id="formError" class="alert alert-danger mt-3 d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <span id="submitBtnText"><i class="ri-save-line me-1"></i>Kaydet</span>
                        <span id="submitBtnSpinner" class="d-none"><span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<style>
.method-card{transition:all .2s;border-left:4px solid transparent}
.method-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.08)}
.method-card.type-plisio{border-left-color:#f7931a}
.method-card.type-bank_transfer{border-left-color:#0ab39c}
.method-card.type-credit_card{border-left-color:#405189}
.method-card.type-crypto_wallet{border-left-color:#f06548}
.method-card.type-manual{border-left-color:#878a99}
.method-card.type-fast_crypto{border-left-color:#f7931a}
.method-card .method-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px}
.method-card.type-fast_crypto .method-icon{background:rgba(247,147,26,.1);color:#f7931a}
.method-card.type-plisio .method-icon{background:rgba(247,147,26,.1);color:#f7931a}
.method-card.type-bank_transfer .method-icon{background:rgba(10,179,156,.1);color:#0ab39c}
.method-card.type-credit_card .method-icon{background:rgba(64,81,137,.1);color:#405189}
.method-card.type-crypto_wallet .method-icon{background:rgba(240,101,72,.1);color:#f06548}
.method-card.type-manual .method-icon{background:rgba(135,138,153,.1);color:#878a99}
.method-inactive{opacity:.55}
.wallet-row{background:var(--vz-light);border-radius:8px;padding:10px 12px}
.wallet-row:hover{background:rgba(var(--vz-primary-rgb),.05)}
.wallet-row .wallet-addr{font-family:'Courier New',monospace;font-size:.82rem;word-break:break-all}
.wallet-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:6px;font-size:.7rem;font-weight:600;background:rgba(var(--vz-primary-rgb),.1);color:var(--vz-primary)}
</style>
<script>
let allMethods=[];
const typeLabels={fast_crypto:'Hızlı Kripto',plisio:'Plisio (Kripto)',bank_transfer:'Banka Havalesi',credit_card:'Kredi Kartı',crypto_wallet:'Kripto Cüzdan',manual:'Manuel Ödeme'};
const typeIcons={fast_crypto:'ri-flashlight-line',plisio:'ri-bit-coin-line',bank_transfer:'ri-bank-line',credit_card:'ri-bank-card-line',crypto_wallet:'ri-wallet-3-line',manual:'ri-hand-coin-line'};

async function loadMethods(){
    try{
        const r=await fetch('/api/payment-methods');
        if(!r.ok)throw new Error();
        allMethods=await r.json();
    }catch{document.getElementById('loadingState').innerHTML='<span class="text-danger">Yüklenemedi.</span>';return;}
    renderMethods();
}

function parseWallets(m){
    if(m.extraConfig){
        try{return JSON.parse(m.extraConfig);}catch{}
    }
    if(m.walletAddress)return [m.walletAddress];
    return [];
}

function renderMethods(){
    const c=document.getElementById('methodsContainer');
    const e=document.getElementById('emptyState');
    const l=document.getElementById('loadingState');
    if(l)l.remove();

    document.getElementById('stat-total').textContent=allMethods.length;
    document.getElementById('stat-active').textContent=allMethods.filter(m=>m.isActive).length;
    document.getElementById('stat-inactive').textContent=allMethods.filter(m=>!m.isActive).length;
    const def=allMethods.find(m=>m.isDefault);
    document.getElementById('stat-default').textContent=def?def.name:'-';

    if(!allMethods.length){c.innerHTML='';e.classList.remove('d-none');return;}
    e.classList.add('d-none');
    c.innerHTML='';

    allMethods.forEach(m=>{
        const icon=m.icon||typeIcons[m.type]||'ri-bank-card-line';
        const info=getMethodInfo(m);
        c.innerHTML+=`
        <div class="col-xl-4 col-md-6">
            <div class="card method-card type-${m.type} ${m.isActive?'':'method-inactive'} mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="method-icon"><i class="${icon}"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="mb-0 text-truncate">${m.name}</h6>
                                ${m.isDefault?'<span class="badge bg-info-subtle text-info fs-10">Varsayılan</span>':''}
                            </div>
                            <span class="badge bg-light text-body fs-10 mb-2">${typeLabels[m.type]||m.type}</span>
                            ${m.description?`<p class="text-muted fs-12 mb-1">${m.description}</p>`:''}
                            ${info}
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" ${m.isActive?'checked':''} onchange="toggleMethod(${m.id},this)">
                            <label class="form-check-label fs-12 ${m.isActive?'text-success':'text-danger'}">${m.isActive?'Aktif':'Pasif'}</label>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-soft-warning" onclick="openEditModal(${m.id})" title="Düzenle"><i class="ri-pencil-line"></i></button>
                            <button class="btn btn-sm btn-soft-danger" onclick="deleteMethod(${m.id})" title="Sil"><i class="ri-delete-bin-line"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>`;
    });
}

function getMethodInfo(m){
    if(m.type==='fast_crypto'){
        const wallets=parseWallets(m);
        let html='';
        if(wallets.length>0){
            html+=`<div class="mt-2 mb-1"><span class="wallet-badge"><i class="ri-wallet-3-line"></i>${wallets.length} Cüzdan</span></div>`;
            html+='<div class="vstack gap-1 mt-1">';
            wallets.forEach((w,i)=>{
                html+=`<div class="fs-11 text-muted font-monospace"><i class="ri-arrow-right-s-line"></i>${w.substring(0,12)}...${w.substring(w.length-6)}</div>`;
            });
            html+='</div>';
        }
        html+=`<div class="fs-11 text-muted mt-1"><i class="ri-flashlight-line me-1"></i>Otomatik TronScan doğrulama</div>`;
        return html;
    }
    if(m.type==='bank_transfer'){
        const parts=[];
        if(m.bankName)parts.push(`<i class="ri-bank-line me-1"></i>${m.bankName}`);
        if(m.iban)parts.push(`<i class="ri-file-list-line me-1"></i>${m.iban.substring(0,10)}...`);
        if(m.accountHolder)parts.push(`<i class="ri-user-line me-1"></i>${m.accountHolder}`);
        return parts.length?`<div class="fs-11 text-muted">${parts.join('<br>')}</div>`:'';
    }
    if(m.type==='crypto_wallet'){
        const parts=[];
        if(m.walletNetwork)parts.push(`<i class="ri-global-line me-1"></i>${m.walletNetwork}`);
        if(m.walletAddress)parts.push(`<i class="ri-wallet-line me-1"></i>${m.walletAddress.substring(0,12)}...`);
        return parts.length?`<div class="fs-11 text-muted">${parts.join('<br>')}</div>`:'';
    }
    return '';
}

function previewIcon(){
    const val=document.getElementById('f-icon').value.trim();
    document.getElementById('iconPreview').className=val||'ri-bank-card-line';
}

function onTypeChange(){
    const t=document.getElementById('f-type').value;
    document.getElementById('bankFields').classList.toggle('d-none',t!=='bank_transfer');
    document.getElementById('singleWalletFields').classList.toggle('d-none',t!=='crypto_wallet');
    document.getElementById('multiWalletFields').classList.toggle('d-none',t!=='fast_crypto');
    if(!document.getElementById('f-icon').value){
        document.getElementById('f-icon').value=typeIcons[t]||'';
        previewIcon();
    }
}

let walletRowId=0;
function addWalletRow(addr=''){
    walletRowId++;
    const id='wr'+walletRowId;
    const list=document.getElementById('walletList');
    const row=document.createElement('div');
    row.className='wallet-row d-flex align-items-center gap-2';
    row.id=id;
    row.innerHTML=`
        <div class="flex-shrink-0"><i class="ri-wallet-3-line text-primary fs-16"></i></div>
        <input type="text" class="form-control form-control-sm font-monospace" placeholder="T... cüzdan adresi" value="${addr}" oninput="updateWalletCount()">
        <button type="button" class="btn btn-sm btn-soft-danger flex-shrink-0" onclick="removeWalletRow('${id}')"><i class="ri-delete-bin-line"></i></button>
    `;
    list.appendChild(row);
    updateWalletCount();
}

function removeWalletRow(id){
    document.getElementById(id)?.remove();
    updateWalletCount();
}

function updateWalletCount(){
    const inputs=document.querySelectorAll('#walletList input[type=text]');
    const count=Array.from(inputs).filter(i=>i.value.trim()).length;
    document.getElementById('walletCount').textContent=count;
}

function getWalletAddresses(){
    const inputs=document.querySelectorAll('#walletList input[type=text]');
    return Array.from(inputs).map(i=>i.value.trim()).filter(Boolean);
}

function resetForm(){
    document.getElementById('methodForm').reset();
    document.getElementById('f-id').value='';
    document.getElementById('f-active').checked=true;
    document.getElementById('f-default').checked=false;
    document.getElementById('bankFields').classList.add('d-none');
    document.getElementById('singleWalletFields').classList.add('d-none');
    document.getElementById('multiWalletFields').classList.add('d-none');
    document.getElementById('walletList').innerHTML='';
    document.getElementById('formError').classList.add('d-none');
    walletRowId=0;
    updateWalletCount();
    previewIcon();
}

function openAddModal(){
    resetForm();
    document.getElementById('modalHeader').className='modal-header bg-primary-subtle';
    document.getElementById('modalTitle').innerHTML='<i class="ri-add-line me-2"></i>Yeni Ödeme Yöntemi';
    document.getElementById('submitBtn').className='btn btn-primary';
    onTypeChange();
    addWalletRow();
    new bootstrap.Modal(document.getElementById('methodModal')).show();
}

function openEditModal(id){
    resetForm();
    const m=allMethods.find(x=>x.id===id);if(!m)return;
    document.getElementById('f-id').value=m.id;
    document.getElementById('f-name').value=m.name||'';
    document.getElementById('f-type').value=m.type||'manual';
    document.getElementById('f-desc').value=m.description||'';
    document.getElementById('f-icon').value=m.icon||'';
    document.getElementById('f-sort').value=m.sortOrder||0;
    document.getElementById('f-active').checked=m.isActive;
    document.getElementById('f-default').checked=m.isDefault;
    document.getElementById('f-bankName').value=m.bankName||'';
    document.getElementById('f-accountHolder').value=m.accountHolder||'';
    document.getElementById('f-iban').value=m.iban||'';
    document.getElementById('f-walletAddress').value=m.walletAddress||'';
    document.getElementById('f-walletNetwork').value=m.walletNetwork||'';

    if(m.type==='fast_crypto'){
        const wallets=parseWallets(m);
        if(wallets.length>0){
            wallets.forEach(w=>addWalletRow(w));
        }else{
            addWalletRow();
        }
    }

    previewIcon();
    onTypeChange();
    document.getElementById('modalHeader').className='modal-header bg-warning-subtle';
    document.getElementById('modalTitle').innerHTML='<i class="ri-pencil-line me-2"></i>Ödeme Yöntemi Düzenle';
    document.getElementById('submitBtn').className='btn btn-warning';
    new bootstrap.Modal(document.getElementById('methodModal')).show();
}

function setBtn(loading){
    const t=document.getElementById('submitBtnText'),s=document.getElementById('submitBtnSpinner'),b=document.getElementById('submitBtn');
    if(loading){t.classList.add('d-none');s.classList.remove('d-none');b.disabled=true;}
    else{t.classList.remove('d-none');s.classList.add('d-none');b.disabled=false;}
}

document.addEventListener('DOMContentLoaded',()=>{loadMethods();});

document.getElementById('methodForm')?.addEventListener('submit',async e=>{
    e.preventDefault();
    setBtn(true);
    const err=document.getElementById('formError');err.classList.add('d-none');
    const id=document.getElementById('f-id').value;
    const isEdit=!!id;
    const methodType=document.getElementById('f-type').value;

    const payload={
        name:document.getElementById('f-name').value.trim(),
        type:methodType,
        description:document.getElementById('f-desc').value.trim()||null,
        icon:document.getElementById('f-icon').value.trim()||null,
        bankName:document.getElementById('f-bankName').value.trim()||null,
        accountHolder:document.getElementById('f-accountHolder').value.trim()||null,
        iban:document.getElementById('f-iban').value.trim()||null,
        walletAddress:methodType==='crypto_wallet'?(document.getElementById('f-walletAddress').value.trim()||null):null,
        walletNetwork:document.getElementById('f-walletNetwork').value.trim()||null,
        isActive:document.getElementById('f-active').checked,
        isDefault:document.getElementById('f-default').checked,
        sortOrder:parseInt(document.getElementById('f-sort').value)||0
    };

    if(methodType==='fast_crypto'){
        const wallets=getWalletAddresses();
        if(wallets.length===0){
            err.textContent='En az bir cüzdan adresi gereklidir.';
            err.classList.remove('d-none');
            setBtn(false);
            return;
        }
        payload.extraConfig=JSON.stringify(wallets);
        payload.walletAddress=wallets[0];
    }

    try{
        const url=isEdit?`/api/payment-methods/${id}`:'/api/payment-methods';
        const res=await fetch(url,{method:isEdit?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
        if(res.ok){
            await loadMethods();
            bootstrap.Modal.getInstance(document.getElementById('methodModal'))?.hide();
            Swal.fire({icon:'success',title:isEdit?'Güncellendi':'Eklendi',timer:1500,showConfirmButton:false});
        }else{
            const d=await res.json().catch(()=>({}));
            err.textContent=d.message||'İşlem başarısız.';err.classList.remove('d-none');
        }
    }catch{err.textContent='Sunucuya ulaşılamadı.';err.classList.remove('d-none');}
    setBtn(false);
});

async function toggleMethod(id,el){
    try{
        const r=await fetch(`/api/payment-methods/${id}/toggle`,{method:'POST'});
        if(r.ok){
            const d=await r.json();
            const m=allMethods.find(x=>x.id===id);if(m)m.isActive=d.isActive;
            renderMethods();
        }else{el.checked=!el.checked;}
    }catch{el.checked=!el.checked;}
}

async function deleteMethod(id){
    const r=await Swal.fire({title:'Emin misiniz?',text:'Bu ödeme yöntemi kalıcı olarak silinecek.',icon:'warning',showCancelButton:true,confirmButtonText:'Evet, sil',cancelButtonText:'Vazgeç',confirmButtonColor:'#f06548'});
    if(!r.isConfirmed)return;
    try{
        const res=await fetch(`/api/payment-methods/${id}`,{method:'DELETE'});
        if(res.ok){allMethods=allMethods.filter(m=>m.id!==id);renderMethods();Swal.fire({icon:'success',title:'Silindi',timer:1500,showConfirmButton:false});}
        else{const d=await res.json().catch(()=>({}));Swal.fire('Hata',d.message||'Silme başarısız','error');}
    }catch{Swal.fire('Hata','Sunucuya ulaşılamadı','error');}
}
</script>
}
