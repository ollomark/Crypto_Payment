    <!-- Bildirim Çanı Script -->
    <script>
    (function() {
        async function loadNotifications() {
            try {
                const res = await fetch('/api/my-approvals/pending-count');
                if (!res.ok) return;
                const data = await res.json();
                const count = data.count || 0;
                const badge = document.getElementById('approval-badge');
                const badgeText = document.getElementById('approval-badge-text');
                const sidebarBadge = document.getElementById('sidebar-approval-badge');
                if (badge) { badge.textContent = count; badge.style.display = count > 0 ? '' : 'none'; }
                if (badgeText) badgeText.textContent = count + ' Bekleyen';
                if (sidebarBadge) { sidebarBadge.textContent = count; sidebarBadge.style.display = count > 0 ? '' : 'none'; }

                if (count > 0) {
                    const res2 = await fetch('/api/my-approvals/pending-list');
                    if (!res2.ok) return;
                    const list = await res2.json();
                    const container = document.getElementById('notificationList');
                    const noNote = document.getElementById('noNotification');
                    if (!container) return;
                    if (noNote) noNote.style.display = 'none';
                    container.innerHTML = '';
                    list.slice(0, 5).forEach(item => {
                        const d = new Date(item.createdDate).toLocaleDateString('tr-TR');
                        container.innerHTML += `
                        <div class="text-reset notification-item d-block dropdown-item position-relative">
                            <div class="d-flex">
                                <div class="avatar-xs me-3 flex-shrink-0">
                                    <span class="avatar-title bg-warning-subtle text-warning rounded-circle fs-16">
                                        <i class="ri-time-line"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <a href="/approvals" class="stretched-link">
                                        <h6 class="mt-0 mb-1 fs-13 fw-semibold">${item.requestedByName || 'Kullanıcı'}</h6>
                                    </a>
                                    <div class="fs-13 text-muted">
                                        <p class="mb-1">${item.description || item.requestType}</p>
                                    </div>
                                    <p class="mb-0 fs-11 fw-medium text-uppercase text-muted"><span><i class="ri-time-line"></i> ${d}</span></p>
                                </div>
                            </div>
                        </div>`;
                    });
                }
            } catch(e) {}
        }
        document.addEventListener('DOMContentLoaded', loadNotifications);
        setInterval(loadNotifications, 30000);
    })();
    </script>

