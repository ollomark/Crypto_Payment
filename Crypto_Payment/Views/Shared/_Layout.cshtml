    <!-- PWA & Push Notifications -->
    <script src="~/js/pwa-push.js"></script>
    <script>
    (function() {
        var banner = document.getElementById('pushBanner');
        var bannerBtn = document.getElementById('pushBannerBtn');
        var bannerDismiss = document.getElementById('pushBannerDismiss');
        var area = document.getElementById('pushEnableArea');
        var btn = document.getElementById('btnEnablePush');
        var mobileBtn = document.getElementById('mobile-enable-push-btn');
        var dismissedKey = 'pushBannerDismissed';
        function showBanner() {
            if (localStorage.getItem(dismissedKey)) return false;
            if (!('Notification' in window)) return false;
            if (localStorage.getItem('notifyLocalEnabled') === '1') return false;
            if (Notification.permission === 'granted') return false;
            return true;
        }
        function updateUI() {
            var show = showBanner();
            if (banner) banner.style.display = show ? 'block' : 'none';
            var showDropdown = typeof window.isPushEnabled === 'function' && !window.isPushEnabled() && 'Notification' in window && Notification.permission === 'default';
            if (area) area.style.display = showDropdown ? '' : 'none';
            if (mobileBtn) mobileBtn.style.display = showDropdown ? '' : 'none';
        }
        function onEnableClick() {
            if (typeof window.enablePushNotifications === 'function') {
                window.enablePushNotifications().then(function(ok) {
                    updateUI();
                });
            }
        }
        document.addEventListener('DOMContentLoaded', function() {
            updateUI();
            if (bannerBtn) bannerBtn.addEventListener('click', onEnableClick);
            if (bannerDismiss) bannerDismiss.addEventListener('click', function() {
                localStorage.setItem(dismissedKey, '1');
                if (banner) banner.style.display = 'none';
            });
            if (btn) btn.addEventListener('click', onEnableClick);
            if (mobileBtn) mobileBtn.addEventListener('click', onEnableClick);
        });
        document.addEventListener('pwaReady', updateUI);
        document.addEventListener('pushEnabled', updateUI);
    })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
