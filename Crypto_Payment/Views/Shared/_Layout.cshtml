    <!-- Menü Toggle Script -->
    <script>
    (function() {
        'use strict';
        
        document.addEventListener('DOMContentLoaded', function() {
            // Aktif menü öğesini bul ve işaretle
            var path = window.location.pathname.replace(/\/+$/, '') || '/';
            var navLinks = document.querySelectorAll('#navbar-nav .nav-link[data-page]');
            var matched = null;
            navLinks.forEach(function(link) {
                var page = link.getAttribute('data-page');
                if (page === path) { matched = link; }
                else if (page !== '/' && path.startsWith(page) && (!matched || page.length > matched.getAttribute('data-page').length)) {
                    matched = link;
                }
            });
            if (matched) matched.classList.add('active');

            // Mobil bottom nav aktif öğe
            document.querySelectorAll('.mobile-bottom-nav__item[data-page]').forEach(function(link) {
                var page = link.getAttribute('data-page');
                if (page === path || (page !== '/' && path.startsWith(page))) {
                    link.classList.add('active');
                }
            });

            var hamburgerBtn = document.getElementById('topnav-hamburger-icon');
            var mobileNavMenuBtn = document.getElementById('mobile-nav-menu-btn');
            var verticalOverlay = document.querySelector('.vertical-overlay');
            var html = document.documentElement;

            function doToggleSidebar() {
                if (window.innerWidth >= 992) {
                    var currentSize = html.getAttribute('data-sidebar-size');
                    html.setAttribute('data-sidebar-size', currentSize === 'sm' ? 'lg' : 'sm');
                } else {
                    document.body.classList.toggle('vertical-sidebar-enable');
                }
            }
            
            if (hamburgerBtn) hamburgerBtn.addEventListener('click', function(e) { e.preventDefault(); doToggleSidebar(); });
            if (mobileNavMenuBtn) mobileNavMenuBtn.addEventListener('click', function(e) { e.preventDefault(); doToggleSidebar(); });
            
            // Overlay click - menüyü kapat
            if (verticalOverlay) {
                verticalOverlay.addEventListener('click', function() {
                    document.body.classList.remove('vertical-sidebar-enable');
                });
            }
            
            // Sayfa yüklendiğinde sidebar durumunu ayarla
            if (window.innerWidth < 992) {
                html.setAttribute('data-sidebar-size', 'lg');
            }
            
            // Pencere boyutu değiştiğinde
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 992) {
                    document.body.classList.remove('vertical-sidebar-enable');
                }
            });
        });
    })();
    </script>
    
    <!-- Dark/Light Mode Toggle -->
    <script>
    (function() {
        'use strict';
        var html = document.documentElement;
        var savedMode = localStorage.getItem('theme-mode');

        function applyMode(mode) {
            html.setAttribute('data-layout-mode', mode);
            html.setAttribute('data-bs-theme', mode);
            html.setAttribute('data-topbar', mode === 'dark' ? 'dark' : 'light');
            html.setAttribute('data-sidebar', 'dark');
            var icon = document.getElementById('light-dark-icon');
            var mobileIcon = document.getElementById('mobile-light-dark-icon');
            var iconClass = mode === 'dark' ? 'bx bx-sun fs-22' : 'bx bx-moon fs-22';
            var mobileIconClass = mode === 'dark' ? 'bx bx-sun fs-18 me-2' : 'bx bx-moon fs-18 me-2';
            if (icon) icon.className = iconClass;
            if (mobileIcon) mobileIcon.className = mobileIconClass;
            localStorage.setItem('theme-mode', mode);
        }

        if (savedMode) applyMode(savedMode);

        document.addEventListener('DOMContentLoaded', function() {
            if (savedMode) applyMode(savedMode);
            function toggleTheme() {
                var current = html.getAttribute('data-layout-mode') || 'light';
                applyMode(current === 'dark' ? 'light' : 'dark');
            }
            var btn = document.getElementById('light-dark-mode-btn');
            var mobileBtn = document.getElementById('mobile-light-dark-mode-btn');
            if (btn) btn.addEventListener('click', toggleTheme);
            if (mobileBtn) mobileBtn.addEventListener('click', toggleTheme);
        });
    })();
    </script>

