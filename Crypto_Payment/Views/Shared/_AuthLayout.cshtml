<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — WandaPlay</title>
    <script>
        (function(){var m=localStorage.getItem('theme-mode');if(m)document.documentElement.setAttribute('data-bs-theme',m);})();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta content="WandaPlay Kripto Ödeme Yönetim Paneli" name="description"/>
    <link rel="shortcut icon" href="~/admin/velzon-dist/assets/images/favicon.ico">

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="~/admin/velzon-dist/assets/js/layout.js"></script>
    <link href="~/admin/velzon-dist/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css"/>
    <link href="~/admin/velzon-dist/assets/css/icons.min.css" rel="stylesheet" type="text/css"/>
    <link href="~/admin/velzon-dist/assets/css/app.min.css" rel="stylesheet" type="text/css"/>
    <link href="~/admin/velzon-dist/assets/css/custom.min.css" rel="stylesheet" type="text/css"/>
    <style>
        :root{--vz-font-family-primary:'Inter',sans-serif;--vz-font-family-secondary:'Inter',sans-serif;--vz-body-font-family:'Inter',sans-serif;--vz-headings-font-family:'Inter',sans-serif}
        body{font-family:'Inter',sans-serif!important;letter-spacing:-0.01em}
        h1,h2,h3,h4,h5,h6{font-family:'Inter',sans-serif!important;font-weight:600}
        .btn{font-family:'Inter',sans-serif!important;font-weight:500}
        .form-control,.form-select{font-family:'Inter',sans-serif!important}
        .form-label{font-weight:500}
        .auth-page-wrapper{min-height:100vh;display:flex;flex-direction:column}
        .auth-page-content{flex:1;display:flex;align-items:center;justify-content:center;padding:0 16px 40px;box-sizing:border-box}
        .card-bg-fill{backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.08)}
        .form-control:focus{border-color:#405189;box-shadow:0 0 0 .15rem rgba(64,81,137,.25)}
        .form-control.ps-5{padding-left:2.8rem!important}
        .auth-one-bg{background:linear-gradient(135deg,#1a1d3e 0%,#2a2d5e 50%,#1a1d3e 100%)}
        footer.footer{position:relative;z-index:1}
    </style>
</head>
<body>
    <div class="auth-page-wrapper pt-5">
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div class="bg-overlay"></div>
            <div class="shape">
                <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 1440 120">
                    <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                </svg>
            </div>
        </div>

        <div class="auth-page-content">
            @RenderBody()
        </div>

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center">
                            <p class="mb-0 text-muted">&copy; <script>document.write(new Date().getFullYear())</script> WandaPlay. Tüm hakları saklıdır.</p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/admin/velzon-dist/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/velzon-dist/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/admin/velzon-dist/assets/libs/node-waves/waves.min.js"></script>
    <script src="~/admin/velzon-dist/assets/libs/feather-icons/feather.min.js"></script>
    <script src="~/admin/velzon-dist/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/admin/velzon-dist/assets/js/plugins.js"></script>
    <script src="~/admin/velzon-dist/assets/libs/particles.js/particles.js"></script>
    <script src="~/admin/velzon-dist/assets/js/pages/particles.app.js"></script>
    <script src="~/admin/velzon-dist/assets/js/pages/password-addon.init.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
