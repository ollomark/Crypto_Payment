@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    var tr = new CultureInfo("tr-TR");
    string F(decimal v) => v.ToString("N2", tr);
    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var totalInvoices = ViewBag.TotalInvoices ?? 0;
    var totalInvoiceAmount = ViewBag.TotalInvoiceAmount ?? 0m;
    var pendingAmount = ViewBag.PendingAmount ?? 0m;
    var paidAmount = ViewBag.PaidAmount ?? 0m;
    var pendingCount = ViewBag.PendingCount ?? 0;
    var totalExpenses = ViewBag.TotalExpenses ?? 0m;
    var netKasa = ViewBag.NetKasa ?? 0m;
    var isMasterAdmin = User.IsInRole("MasterAdmin");
    var recentInvoices = ViewBag.RecentInvoices as List<Crypto_Payment.DTOS.InvoiceDto> ?? new List<Crypto_Payment.DTOS.InvoiceDto>();
}

<!-- Skeleton Placeholder -->
<div class="container-fluid" id="page-skeleton">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-breadcrumb"></div>
            </div>
        </div>
    </div>
    <div class="row">
        @for (int sk = 0; sk < 4; sk++)
        {
        <div class="col-xl-3 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="skeleton skeleton-text-sm" style="width:100px;margin-bottom:16px;"></div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <div class="skeleton skeleton-card-value" style="margin-bottom:16px;"></div>
                            <div class="skeleton skeleton-text-sm" style="width:110px;"></div>
                        </div>
                        <div class="skeleton" style="width:40px;height:40px;border-radius:8px;"></div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    <div class="row">
        @for (int sk = 0; sk < 3; sk++)
        {
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="skeleton skeleton-text-sm" style="width:100px;margin-bottom:16px;"></div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <div class="skeleton skeleton-card-value" style="margin-bottom:16px;"></div>
                            <div class="skeleton skeleton-text-sm" style="width:110px;"></div>
                        </div>
                        <div class="skeleton" style="width:40px;height:40px;border-radius:8px;"></div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    <div class="row">
        <div class="col-12"><div class="card"><div class="card-body"><div class="skeleton skeleton-chart w-100"></div></div></div></div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header"><div class="skeleton skeleton-text" style="width:120px;"></div></div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table mb-0"><tbody>
                            @for (int sk = 0; sk < 5; sk++)
                            {
                            <tr class="skeleton-row">
                                <td><div class="skeleton skeleton-text" style="width:100px;"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:90px;"></div></td>
                                <td><div class="skeleton skeleton-badge"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:70px;"></div></td>
                                <td><div class="skeleton skeleton-badge"></div></td>
                                <td><div class="skeleton skeleton-btn"></div></td>
                            </tr>
                            }
                        </tbody></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        @for (int sk = 0; sk < 3; sk++)
        {
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="skeleton skeleton-circle mx-auto mb-3" style="width:48px;height:48px;"></div>
                    <div class="skeleton skeleton-text mx-auto" style="width:100px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-text-sm mx-auto" style="width:150px;margin-bottom:12px;"></div>
                    <div class="skeleton skeleton-btn mx-auto" style="width:100px;"></div>
                </div>
            </div>
        </div>
        }
    </div>
</div>

<div class="container-fluid" id="page-real" style="display:none;">

    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <h4 class="mb-sm-0">Dashboard</h4>

                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </div>

            </div>
        </div>
    </div>
    <!-- end page title -->

    <!-- İstatistik Kartları -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Toplam Müşteri</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4"><span class="counter-value" data-target="@totalCustomers">@totalCustomers</span></h4>
                            <a href="/customers" class="text-decoration-underline text-muted">Müşterileri Görüntüle</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-primary-subtle rounded fs-3">
                                <i class="ri-user-line text-primary"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Toplam Fatura</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4"><span class="counter-value" data-target="@totalInvoices">@totalInvoices</span></h4>
                            <a href="/invoices" class="text-decoration-underline text-muted">Faturaları Görüntüle</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-success-subtle rounded fs-3">
                                <i class="ri-file-list-3-line text-success"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Ödenmiş Tutar</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-success-subtle text-success">Tahsil Edildi</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4 text-success"><span class="currency-display" data-base-amount="@paidAmount" data-source-currency="EUR">€ @F(paidAmount)</span></h4>
                            <a href="/invoices" class="text-decoration-underline text-muted">Ödenmiş Faturaları Gör</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-success-subtle rounded fs-3">
                                <i class="ri-checkbox-circle-line text-success"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Bekleyen Faturalar</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-warning-subtle text-warning">@pendingCount Adet</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4 text-warning"><span class="currency-display" data-base-amount="@pendingAmount" data-source-currency="EUR">€ @F(pendingAmount)</span></h4>
                            <a href="/invoices" class="text-decoration-underline text-muted">Bekleyenleri Gör</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-warning-subtle rounded fs-3">
                                <i class="ri-time-line text-warning"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end row -->

    <!-- Net Kasa Satırı -->
    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate border-0" style="background: linear-gradient(135deg, #405189, #0ab39c);">
                <div class="card-body text-white">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <p class="text-uppercase fw-medium mb-0" style="opacity:.8;">Net Kasa</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-white text-dark">Gelir - Gider</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-2 text-white"><span class="currency-display" data-base-amount="@netKasa" data-source-currency="EUR">€ @F(netKasa)</span></h4>
                            <small style="opacity:.75;">Tahsil: <span class="currency-display" data-base-amount="@paidAmount" data-source-currency="EUR">€ @F(paidAmount)</span> &nbsp;|&nbsp; Gider: <span class="currency-display" data-base-amount="@totalExpenses" data-source-currency="EUR">€ @F(totalExpenses)</span></small>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title rounded fs-3" style="background:rgba(255,255,255,.2);">
                                <i class="ri-safe-line text-white"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Toplam Gider</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-danger-subtle text-danger">Onaylanan</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4 text-danger"><span class="currency-display" data-base-amount="@totalExpenses" data-source-currency="EUR">€ @F(totalExpenses)</span></h4>
                            <a href="/expenses" class="text-decoration-underline text-muted">Giderleri Gör</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-danger-subtle rounded fs-3">
                                <i class="ri-arrow-down-circle-line text-danger"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isMasterAdmin)
        {
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Onay Bekleyen</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-warning-subtle text-warning" id="dash-approval-count">0 Adet</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4 text-warning" id="dash-approval-num">0</h4>
                            <a href="/approvals" class="text-decoration-underline text-muted">Onayları Gör</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-warning-subtle rounded fs-3">
                                <i class="ri-checkbox-circle-line text-warning"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    <!-- end net kasa row -->

    @if (isMasterAdmin)
    {
    <!-- Finansal Akış Grafiği (sadece MasterAdmin) -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">
                        <i class="ri-line-chart-line me-2 text-primary"></i>Finansal Akış Özeti
                    </h4>
                    <div class="flex-shrink-0">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-primary active" id="chart-12months">Son 12 Ay</button>
                            <button type="button" class="btn btn-outline-primary" id="chart-30days">Son 30 Gün</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="financial-chart" style="min-height:320px;">
                        <div id="chart-skeleton" class="d-flex align-items-end justify-content-around px-3" style="height:300px;gap:12px;">
                            @for (int i = 0; i < 12; i++)
                            {
                                var h = 40 + (i * 7 % 60);
                                <div class="skeleton" style="flex:1;height:@(h)%;border-radius:4px 4px 0 0;"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end grafik row -->
    }

    <!-- Son Faturalar -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">Son Faturalar</h4>
                    <div class="flex-shrink-0">
                        <a href="/invoices" class="btn btn-soft-primary btn-sm">
                            Tümünü Gör <i class="ri-arrow-right-line align-middle"></i>
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive table-card">
                        <table class="table table-hover table-centered align-middle mb-0">
                            <thead class="text-muted table-light">
                                <tr>
                                    <th scope="col">Şirket Adı</th>
                                    <th scope="col">Sipariş Adı</th>
                                    <th scope="col">Para Birimi</th>
                                    <th scope="col">Tutar</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentInvoices != null && recentInvoices.Any())
                                {
                                    foreach (var invoice in recentInvoices)
                                    {
                                        var statusClass = invoice.Status switch
                                        {
                                            "completed" => "success",
                                            "mismatch" => "success",
                                            "pending" => "warning",
                                            "expired" => "danger",
                                            "cancelled" => "secondary",
                                            _ => "info"
                                        };
                                        var statusText = invoice.Status switch
                                        {
                                            "completed" => "Ödendi",
                                            "mismatch" => "Fazla Ödendi",
                                            "pending" => "Bekliyor",
                                            "expired" => "Süresi Doldu",
                                            "cancelled" => "İptal",
                                            _ => "Yeni"
                                        };
                                        var companyName = !string.IsNullOrEmpty(invoice.Customer?.CompanyName)
                                            ? invoice.Customer.CompanyName
                                            : (!string.IsNullOrEmpty(invoice.Customer?.FirstName)
                                                ? $"{invoice.Customer.FirstName} {invoice.Customer.LastName}"
                                                : invoice.Email);
                                        <tr>
                                            <td>
                                                <span class="fw-medium">@companyName</span>
                                            </td>
                                            <td>@invoice.OrderName</td>
                                            <td>
                                                <span class="badge bg-info-subtle text-info">@(invoice.SourceCurrency?.ToUpper() switch { "USD" => "$", "EUR" or "EURO" => "€", "TRY" or "TL" => "₺", "GBP" => "£", _ => invoice.SourceCurrency }) → @invoice.Currency</span>
                                            </td>
                                            <td>
                                                <span class="text-success fw-medium currency-display" data-base-amount="@invoice.SourceAmount" data-source-currency="@invoice.SourceCurrency">€ @invoice.SourceAmount</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@statusClass-subtle text-@statusClass">@statusText</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(invoice.TxnId))
                                                {
                                                    <a href="/pay/@invoice.Id?txnId=@invoice.TxnId" target="_blank" class="btn btn-sm btn-success">
                                                        <i class="ri-external-link-line"></i> Ödeme
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="ri-file-list-3-line fs-24 mb-2 d-block"></i>
                                            Henüz fatura bulunmuyor.
                                            <br>
                                            <a href="/invoices/invoice-add" class="btn btn-primary btn-sm mt-2">İlk Faturanı Oluştur</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end row -->

    <!-- Hızlı İşlemler -->
    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3">
                        <span class="avatar-title bg-primary-subtle rounded-circle fs-1">
                            <i class="ri-user-add-line text-primary"></i>
                        </span>
                    </div>
                    <h5 class="card-title">Yeni Müşteri</h5>
                    <p class="text-muted mb-3">Sisteme yeni müşteri ekleyin</p>
                    <a href="/customers" class="btn btn-primary">Müşteri Ekle</a>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3">
                        <span class="avatar-title bg-success-subtle rounded-circle fs-1">
                            <i class="ri-file-add-line text-success"></i>
                        </span>
                    </div>
                    <h5 class="card-title">Yeni Fatura</h5>
                    <p class="text-muted mb-3">Crypto ödeme faturası oluşturun</p>
                    <a href="/invoices/invoice-add" class="btn btn-success">Fatura Oluştur</a>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3">
                        <span class="avatar-title bg-info-subtle rounded-circle fs-1">
                            <i class="ri-list-check text-info"></i>
                        </span>
                    </div>
                    <h5 class="card-title">Fatura Listesi</h5>
                    <p class="text-muted mb-3">Tüm faturaları görüntüleyin</p>
                    <a href="/invoices" class="btn btn-info">Faturaları Gör</a>
                </div>
            </div>
        </div>
    </div>
    <!-- end row -->

</div>

@section Scripts {
@if (isMasterAdmin)
{
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
<script>
let financialChart = null;

async function loadFinancialChart(period) {
    try {
        const res = await fetch(`/api/stats/financial-chart?period=${period}`);
        if (!res.ok) return;
        const data = await res.json();

        const options = {
            chart: {
                type: 'area',
                height: 320,
                toolbar: { show: false },
                animations: { enabled: true, speed: 600 }
            },
            series: [
                { name: 'Gelir (' + (window.CurrencyConverter?.getCurrentSymbol() || '€') + ')', data: data.income.map(v => parseFloat((v * (window.CurrencyConverter?.getCurrentRate() || 1)).toFixed(2))) },
                { name: 'Gider (' + (window.CurrencyConverter?.getCurrentSymbol() || '€') + ')', data: data.expense.map(v => parseFloat((v * (window.CurrencyConverter?.getCurrentRate() || 1)).toFixed(2))) }
            ],
            colors: ['#0ab39c', '#f06548'],
            fill: {
                type: 'gradient',
                gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05, stops: [0, 90, 100] }
            },
            stroke: { curve: 'smooth', width: 2 },
            xaxis: { categories: data.labels, labels: { style: { fontSize: '11px' } } },
            yaxis: { labels: { formatter: v => (window.CurrencyConverter?.getCurrentSymbol() || '€') + ' ' + v.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) } },
            tooltip: { y: { formatter: v => (window.CurrencyConverter?.getCurrentSymbol() || '€') + ' ' + v.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) } },
            legend: { position: 'top', horizontalAlign: 'right' },
            grid: { borderColor: '#f1f1f1' },
            dataLabels: { enabled: false }
        };

        const el = document.getElementById('financial-chart');
        if (!el) return;
        if (financialChart) { financialChart.destroy(); }
        financialChart = new ApexCharts(el, options);
        financialChart.render();
    } catch(e) { console.error('Grafik yüklenemedi:', e); }
}

document.addEventListener('DOMContentLoaded', async () => {
    // Skeleton kaldır, gerçek içeriği göster
    const skel = document.getElementById('page-skeleton');
    const real = document.getElementById('page-real');
    if (skel) skel.remove();
    if (real) real.style.display = '';

    loadFinancialChart('12months');

    document.getElementById('chart-12months')?.addEventListener('click', function() {
        this.classList.add('active', 'btn-primary'); this.classList.remove('btn-outline-primary');
        const other = document.getElementById('chart-30days');
        other.classList.remove('active', 'btn-primary'); other.classList.add('btn-outline-primary');
        _currentChartPeriod = '12months'; loadFinancialChart('12months');
    });
    document.getElementById('chart-30days')?.addEventListener('click', function() {
        this.classList.add('active', 'btn-primary'); this.classList.remove('btn-outline-primary');
        const other = document.getElementById('chart-12months');
        other.classList.remove('active', 'btn-primary'); other.classList.add('btn-outline-primary');
        _currentChartPeriod = '30days'; loadFinancialChart('30days');
    });

    // Onay bekleyen sayısı
    try {
        const res = await fetch('/api/approvals/pending-count');
        if (res.ok) {
            const data = await res.json();
            const count = data.count || 0;
            const el = document.getElementById('dash-approval-count');
            const num = document.getElementById('dash-approval-num');
            if (el) el.textContent = count + ' Adet';
            if (num) num.textContent = count;
        }
    } catch(e) {}
});

// Para birimi değiştiğinde chart'ı yeniden yükle
let _currentChartPeriod = '12months';
document.addEventListener('currencyChanged', () => {
    loadFinancialChart(_currentChartPeriod);
    window.CurrencyConverter?.convertAll();
});
</script>
}
