@model Crypto_Payment.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<link rel="stylesheet" href="~/css/office-onboarding.css" asp-append-version="true" />

<!-- Skeleton Placeholder -->
<div class="container-fluid" id="page-skeleton">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-breadcrumb"></div>
            </div>
        </div>
    </div>
    <div class="row">
        @for (int sk = 0; sk < 3; sk++)
        {
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="skeleton skeleton-text-sm" style="width:100px;margin-bottom:16px;"></div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <div class="skeleton skeleton-card-value" style="margin-bottom:16px;"></div>
                            <div class="skeleton skeleton-text-sm" style="width:110px;"></div>
                        </div>
                        <div class="skeleton" style="width:40px;height:40px;border-radius:8px;"></div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header"><div class="skeleton skeleton-text" style="width:120px;"></div></div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table mb-0"><tbody>
                            @for (int sk = 0; sk < 5; sk++)
                            {
                            <tr class="skeleton-row">
                                <td><div class="skeleton skeleton-text" style="width:100px;"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:90px;"></div></td>
                                <td><div class="skeleton skeleton-badge"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:70px;"></div></td>
                                <td><div class="skeleton skeleton-badge"></div></td>
                                <td><div class="skeleton skeleton-btn"></div></td>
                            </tr>
                            }
                        </tbody></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        @for (int sk = 0; sk < 3; sk++)
        {
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="skeleton skeleton-circle mx-auto mb-3" style="width:48px;height:48px;"></div>
                    <div class="skeleton skeleton-text mx-auto" style="width:100px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-text-sm mx-auto" style="width:150px;margin-bottom:12px;"></div>
                    <div class="skeleton skeleton-btn mx-auto" style="width:100px;"></div>
                </div>
            </div>
        </div>
        }
    </div>
</div>

<div class="container-fluid" id="page-real" style="display:none;">

    @{
        ViewBag.OnboardingMode = "dashboard";
    }
    @await Html.PartialAsync("_OfficeOnboardingWizard")

    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <h4 class="mb-sm-0">Dashboard</h4>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="changeMonth(-1)"><i class="ri-arrow-left-s-line"></i></button>
                    <span class="fw-semibold fs-14" id="dash-month-label"></span>
                    <button class="btn btn-sm btn-outline-primary" onclick="changeMonth(1)"><i class="ri-arrow-right-s-line"></i></button>
                    <button class="btn btn-sm btn-soft-primary ms-1" onclick="goToCurrentMonth()">Bu Ay</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Toplam Müşteri</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4">@Model.TotalCustomers</h4>
                            <a href="/customers" class="text-decoration-underline text-muted">Müşterileri Görüntüle</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-primary-subtle rounded fs-3">
                                <i class="ri-user-line text-primary"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Aylık Fatura</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4" id="dash-total-invoices">@Model.TotalInvoices</h4>
                            <a href="/invoices" class="text-decoration-underline text-muted">Faturaları Görüntüle</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-success-subtle rounded fs-3">
                                <i class="ri-file-list-3-line text-success"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card card-animate">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Bekleyen Faturalar</p>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-warning-subtle text-warning" id="dash-pending-count-badge">@Model.PendingCount Adet</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-end justify-content-between mt-4">
                        <div>
                            <h4 class="fs-22 fw-semibold ff-secondary mb-4 text-warning" id="dash-pending-count">@Model.PendingCount</h4>
                            <a href="/invoices" class="text-decoration-underline text-muted">Bekleyenleri Gör</a>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-warning-subtle rounded fs-3">
                                <i class="ri-time-line text-warning"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bekleyen Talepler Bilgi Kartı -->
    <div class="row">
        <div class="col-12">
            <div class="alert alert-warning border-0 d-flex align-items-center" role="alert" id="pending-requests-alert" style="display:none!important;">
                <i class="ri-time-line me-2 fs-18"></i>
                <div>
                    <strong id="pending-req-count">0</strong> adet talebiniz onay bekliyor.
                    <a href="/my-requests" class="alert-link ms-2">Taleplerime Git →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Faturalar -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">Son Faturalar</h4>
                    <div class="flex-shrink-0">
                        <a href="/invoices" class="btn btn-soft-primary btn-sm">Tümünü Gör <i class="ri-arrow-right-line align-middle"></i></a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive table-card">
                        <table class="table table-hover table-centered align-middle mb-0">
                            <thead class="text-muted table-light">
                                <tr>
                                    <th>Şirket Adı</th>
                                    <th>Sipariş Adı</th>
                                    <th>Para Birimi</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentInvoices.Any())
                                {
                                    foreach (var invoice in Model.RecentInvoices)
                                    {
                                        var statusClass = invoice.Status switch { "completed" => "success", "mismatch" => "success", "pending" => "warning", "new" => "warning", "expired" => "danger", "cancelled" => "secondary", _ => "warning" };
                                        var statusText = invoice.Status switch { "completed" => "Ödendi", "mismatch" => "Fazla Ödendi", "pending" => "Bekliyor", "new" => "Ödeme Bekliyor", "expired" => "Süresi Doldu", "cancelled" => "İptal", _ => "Ödeme Bekliyor" };
                                        var companyName = !string.IsNullOrEmpty(invoice.Customer?.CompanyName) ? invoice.Customer.CompanyName : (!string.IsNullOrEmpty(invoice.Customer?.FirstName) ? $"{invoice.Customer.FirstName} {invoice.Customer.LastName}" : invoice.Email);
                                        <tr>
                                            <td><span class="fw-medium">@companyName</span></td>
                                            <td>@invoice.OrderName</td>
                                            <td><span class="badge bg-info-subtle text-info">@(invoice.SourceCurrency switch { "USD" => "$", "EUR" or "EURO" => "€", "TRY" or "TL" => "₺", _ => invoice.SourceCurrency }) → @invoice.Currency</span></td>
                                            <td><span class="fw-medium currency-display" data-base-amount="@invoice.SourceAmount" data-source-currency="@invoice.SourceCurrency">€ @invoice.SourceAmount.ToString("N2", new System.Globalization.CultureInfo("tr-TR"))</span></td>
                                            <td><span class="badge bg-@statusClass-subtle text-@statusClass">@statusText</span></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(invoice.TxnId))
                                                {
                                                    <a href="/pay/@invoice.Id?txnId=@invoice.TxnId" target="_blank" class="btn btn-sm btn-success"><i class="ri-external-link-line"></i> Ödeme</a>
                                                }
                                                else { <span class="text-muted">-</span> }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="ri-file-list-3-line fs-24 mb-2 d-block"></i>Henüz fatura bulunmuyor.<br><a href="/invoices/invoice-add" class="btn btn-primary btn-sm mt-2">İlk Faturanı Oluştur</a></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı İşlemler -->
    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3"><span class="avatar-title bg-primary-subtle rounded-circle fs-1"><i class="ri-user-add-line text-primary"></i></span></div>
                    <h5 class="card-title">Yeni Müşteri</h5>
                    <p class="text-muted mb-3">Sisteme yeni müşteri ekleyin</p>
                    <a href="/customers" class="btn btn-primary">Müşteri Ekle</a>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3"><span class="avatar-title bg-success-subtle rounded-circle fs-1"><i class="ri-file-add-line text-success"></i></span></div>
                    <h5 class="card-title">Yeni Fatura</h5>
                    <p class="text-muted mb-3">Crypto ödeme faturası oluşturun</p>
                    <a href="/invoices/invoice-add" class="btn btn-success">Fatura Oluştur</a>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-md mx-auto mb-3"><span class="avatar-title bg-info-subtle rounded-circle fs-1"><i class="ri-file-list-2-line text-info"></i></span></div>
                    <h5 class="card-title">Taleplerim</h5>
                    <p class="text-muted mb-3">Onay bekleyen işlemlerinizi görün</p>
                    <a href="/my-requests" class="btn btn-info">Taleplerime Git</a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
const MONTH_NAMES = ['','Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
let dashYear = @Model.CurrentYear;
let dashMonth = @Model.CurrentMonth;

function updateMonthLabel() {
    document.getElementById('dash-month-label').textContent = MONTH_NAMES[dashMonth] + ' ' + dashYear;
}

function changeMonth(dir) {
    dashMonth += dir;
    if (dashMonth > 12) { dashMonth = 1; dashYear++; }
    if (dashMonth < 1)  { dashMonth = 12; dashYear--; }
    updateMonthLabel();
    loadMonthlyStats();
}

function goToCurrentMonth() {
    const now = new Date();
    dashYear = now.getFullYear();
    dashMonth = now.getMonth() + 1;
    updateMonthLabel();
    loadMonthlyStats();
}

async function loadMonthlyStats() {
    try {
        const res = await fetch(`/api/stats/monthly?year=${dashYear}&month=${dashMonth}`);
        if (!res.ok) return;
        const d = await res.json();
        document.getElementById('dash-total-invoices').textContent = d.totalInvoices;
        document.getElementById('dash-pending-count').textContent = d.pendingCount;
        document.getElementById('dash-pending-count-badge').textContent = d.pendingCount + ' Adet';
    } catch(e) { console.error('Aylık istatistik yüklenemedi:', e); }
}

document.addEventListener('DOMContentLoaded', async () => {
    const skel = document.getElementById('page-skeleton');
    const real = document.getElementById('page-real');
    if (skel) skel.remove();
    if (real) real.style.display = '';

    updateMonthLabel();

    try {
        const res = await fetch('/api/my-approvals/my-requests');
        if (!res.ok) return;
        const list = await res.json();
        const pending = list.filter(r => r.status === 'Pending').length;
        if (pending > 0) {
            const alert = document.getElementById('pending-requests-alert');
            const cnt = document.getElementById('pending-req-count');
            if (alert) alert.style.removeProperty('display');
            if (cnt) cnt.textContent = pending;
        }
    } catch(e) {}
});
</script>
}
