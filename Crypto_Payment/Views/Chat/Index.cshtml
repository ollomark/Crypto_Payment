// ───── SOUND SYSTEM ─────
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playRingTone() {
    const now = audioCtx.currentTime;
    for (let i = 0; i < 6; i++) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'sine';
        osc.frequency.value = (i % 2 === 0) ? 880 : 698;
        gain.gain.setValueAtTime(0.18, now + i * 0.35);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.35 + 0.3);
        osc.start(now + i * 0.35);
        osc.stop(now + i * 0.35 + 0.3);
    }
}

function playMessageSound() {
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.type = 'sine';
    osc.frequency.setValueAtTime(587, now);
    osc.frequency.setValueAtTime(784, now + 0.08);
    gain.gain.setValueAtTime(0.15, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
    osc.start(now);
    osc.stop(now + 0.2);
}

document.addEventListener('click', () => { if (audioCtx.state === 'suspended') audioCtx.resume(); }, { once: true });

// ───── SUPPORT CHAT (Multi-Tab) ─────
let supportConnection = null;
let supportSessions = [];
let activeSupportSession = null;
let currentTab = 'messages';
let visitorInfoCache = {};
let sessionTimerInterval = null;
let activeSessionStartTime = null;

// Each open chat tab: { sessionId, messages: [{sender,content,time}], hasNewMsg: false }
let openTabs = [];

function switchTab(tab) {
    currentTab = tab;
    document.getElementById('tabMessages').classList.toggle('twc-tab-active', tab === 'messages');
    document.getElementById('tabSupport').classList.toggle('twc-tab-active', tab === 'support');
    document.getElementById('tabGuide').classList.toggle('twc-tab-active', tab === 'guide');
    document.getElementById('tabContentMessages').classList.toggle('twc-show', tab === 'messages');
    document.getElementById('tabContentSupport').classList.toggle('twc-show', tab === 'support');
    document.getElementById('tabContentGuide').classList.toggle('twc-show', tab === 'guide');
}

function renderChatTabs() {
    const bar = document.getElementById('chatTabsBar');
    if (!openTabs.length) { bar.classList.remove('twc-show'); return; }
    bar.classList.add('twc-show');
    bar.innerHTML = openTabs.map(t => {
        const s = supportSessions.find(x => x.sessionId === t.sessionId);
        const name = s?.customerName || 'Müşteri';
        const isActive = activeSupportSession === t.sessionId;
        const flashCls = (!isActive && t.hasNewMsg) ? ' has-new' : '';
        return `<div class="twc-chat-tab${isActive ? ' twc-chat-tab-active' : ''}${flashCls}" onclick="switchToTab('${t.sessionId}')" title="${escHtml(name)}">
            <span class="ct-dot online"></span>
            <span class="ct-name">${escHtml(name)}</span>
            <span class="ct-close" onclick="event.stopPropagation();closeTab('${t.sessionId}')">&times;</span>
        </div>`;
    }).join('');
}

function getOrCreateTab(sessionId) {
    let tab = openTabs.find(t => t.sessionId === sessionId);
    if (!tab) {
        tab = { sessionId, messages: [], hasNewMsg: false };
        openTabs.push(tab);
    }
    return tab;
}

function switchToTab(sessionId) {
    const tab = openTabs.find(t => t.sessionId === sessionId);
    if (!tab) return;
    tab.hasNewMsg = false;

    const session = supportSessions.find(s => s.sessionId === sessionId);
    if (!session) return;

    activeContactId = null;
    activeSupportSession = sessionId;

    document.getElementById('chatEmpty').classList.add('d-none');
    document.getElementById('chatHeader').classList.remove('d-none');
    document.getElementById('chatMessages').classList.remove('d-none');
    document.getElementById('chatInputArea').classList.remove('d-none');
    document.getElementById('typingIndicator').classList.remove('d-none');
    document.getElementById('typingIndicator').textContent = '';
    document.getElementById('btnChatAttach')?.classList.add('d-none');

    document.getElementById('chatHeaderAvatar').style.background = 'linear-gradient(135deg,#667eea,#764ba2)';
    document.getElementById('chatHeaderAvatar').textContent = (session.customerName || '?')[0].toUpperCase();
    document.getElementById('chatHeaderName').innerHTML = escHtml(session.customerName || 'Müşteri') +
        `<span class="support-header-badge"><i class="ri-file-text-line me-1"></i>#${session.invoiceId} – ${escHtml(session.orderName || '')}</span>`;
    document.getElementById('chatHeaderDot').className = 'twc-dot twc-dot-online';
    document.getElementById('chatHeaderStatus').textContent = 'Canlı Destek';
    document.getElementById('chatHeaderStatus').className = 'status-text text-success';

    const msgs = document.getElementById('chatMessages');
    msgs.innerHTML = '';
    tab.messages.forEach(m => appendSupportMessage(m.sender, m.content, m.time));
    scrollToBottom();

    const vp = document.getElementById('visitorPanel');
    vp.classList.add('show');
    activeSessionStartTime = new Date(session.createdDate);
    clearInterval(sessionTimerInterval);
    updateSessionTimer();
    sessionTimerInterval = setInterval(updateSessionTimer, 1000);

    const cached = visitorInfoCache[sessionId] || session;
    updateVisitorPanel(cached);
    document.getElementById('viInvoice').innerHTML = `<strong>#${session.invoiceId}</strong> – ${escHtml(session.orderName || '')}`;
    document.getElementById('livePreviewText').textContent = '';
    document.getElementById('livePreviewBlock').style.display = '';

    renderChatTabs();
    renderSupportList();

    document.getElementById('chatSidebar').classList.add('twc-hidden');
    document.getElementById('messageInput').focus();
}

function closeTab(sessionId) {
    openTabs = openTabs.filter(t => t.sessionId !== sessionId);
    if (activeSupportSession === sessionId) {
        activeSupportSession = null;
        clearInterval(sessionTimerInterval);
        document.getElementById('visitorPanel').classList.remove('show');
        if (openTabs.length > 0) {
            switchToTab(openTabs[openTabs.length - 1].sessionId);
        } else {
            document.getElementById('chatHeader').classList.add('d-none');
            document.getElementById('chatMessages').classList.add('d-none');
            document.getElementById('chatInputArea').classList.add('d-none');
            document.getElementById('typingIndicator').classList.add('d-none');
            document.getElementById('chatEmpty').classList.remove('d-none');
        }
    }
    renderChatTabs();
}

function initSupportHub() {
    supportConnection = new signalR.HubConnectionBuilder()
        .withUrl('/supportChatHub')
        .withAutomaticReconnect()
        .build();

    supportConnection.on('ActiveSessions', sessions => {
        supportSessions = Array.isArray(sessions) ? sessions : [];
        renderSupportList();
    });

    supportConnection.on('NewSupportSession', session => {
        supportSessions = supportSessions.filter(s => s.sessionId !== session.sessionId);
        supportSessions.unshift(session);
        renderSupportList();
        showSupportNotification(session.customerName);
        playRingTone();
    });

    supportConnection.on('SessionTaken', data => {
        const s = supportSessions.find(x => x.sessionId === data.sessionId);
        if (s) { s.hasAdmin = true; s.adminUserId = data.adminUserId; }
        renderSupportList();
    });

    supportConnection.on('SessionEnded', sessionId => {
        supportSessions = supportSessions.filter(s => s.sessionId !== sessionId);
        renderSupportList();
        const tab = openTabs.find(t => t.sessionId === sessionId);
        if (tab) {
            tab.messages.push({ sender: 'system', content: 'Müşteri sohbetten ayrıldı.', time: new Date().toISOString() });
            if (activeSupportSession === sessionId) {
                addSupportChatSystemMsg('Müşteri sohbetten ayrıldı.');
            } else {
                tab.hasNewMsg = true;
            }
            renderChatTabs();
        }
    });

    supportConnection.on('SessionUpdated', data => {
        const s = supportSessions.find(x => x.sessionId === data.sessionId);
        if (s) s.hasAdmin = data.hasAdmin;
        renderSupportList();
    });

    supportConnection.on('SessionHistory', (sessionId, history) => {
        const tab = getOrCreateTab(sessionId);
        if (history && history.length) {
            history.forEach(m => tab.messages.push({ sender: m.sender, content: m.content, time: m.createdDate }));
        }
        if (activeSupportSession === sessionId) {
            const msgs = document.getElementById('chatMessages');
            msgs.innerHTML = '';
            tab.messages.forEach(m => {
                if (m.sender === 'system') addSupportChatSystemMsg(m.content);
                else appendSupportMessage(m.sender, m.content, m.time);
            });
            scrollToBottom();
        }
        renderChatTabs();
    });

    supportConnection.on('SupportMessage', msg => {
        const tab = getOrCreateTab(msg.sessionId);
        tab.messages.push({ sender: msg.sender, content: msg.content, time: msg.createdDate });

        if (msg.sessionId === activeSupportSession) {
            appendSupportMessage(msg.sender, msg.content, msg.createdDate);
            scrollToBottom();
            if (msg.sender === 'customer') {
                document.getElementById('livePreviewText').textContent = '';
            }
        } else {
            tab.hasNewMsg = true;
        }
        renderChatTabs();
        playMessageSound();
    });

    supportConnection.on('SupportMessageSent', msg => {
        const tab = getOrCreateTab(msg.sessionId);
        tab.messages.push({ sender: msg.sender, content: msg.content, time: msg.createdDate });
        if (msg.sessionId === activeSupportSession) {
            appendSupportMessage(msg.sender, msg.content, msg.createdDate);
            scrollToBottom();
        }
        renderChatTabs();
    });

    supportConnection.on('VisitorInfoUpdated', data => {
        visitorInfoCache[data.sessionId] = data;
        const s = supportSessions.find(x => x.sessionId === data.sessionId);
        if (s) { s.ipAddress = data.ipAddress; s.userAgent = data.userAgent; s.pageUrl = data.pageUrl; s.country = data.country; s.city = data.city; s.isp = data.isp; }
        if (data.sessionId === activeSupportSession) updateVisitorPanel(data);
    });

    supportConnection.on('LiveTypingPreview', (sessionId, text) => {
        if (sessionId === activeSupportSession) {
            const el = document.getElementById('livePreviewText');
            const block = document.getElementById('livePreviewBlock');
            if (el && block) { el.textContent = text || ''; block.style.display = ''; }
        }
    });

    supportConnection.on('SupportTyping', (sessionId, who) => {
        if (sessionId === activeSupportSession && who === 'customer') {
            const el = document.getElementById('typingIndicator');
            el.textContent = 'Müşteri yazıyor...';
            el.classList.remove('d-none');
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => el.classList.add('d-none'), 2500);
        }
    });

    supportConnection.on('CustomerLeft', sessionId => {
        if (sessionId === activeSupportSession) {
            addSupportChatSystemMsg('Müşteri sohbetten ayrıldı.');
        }
    });

    supportConnection.start().then(() => {
        supportConnection.invoke('JoinAsAdmin').catch(e => console.error('JoinAsAdmin error:', e));
    }).catch(err => console.error('Support SignalR error:', err));

    supportConnection.onreconnected(() => {
        supportConnection.invoke('JoinAsAdmin').catch(() => {});
    });
}

function renderSupportList() {
    const list = document.getElementById('supportList');
    const empty = document.getElementById('supportEmpty');
    const badge = document.getElementById('supportBadge');

    const pending = supportSessions.filter(s => !s.hasAdmin);
    badge.textContent = pending.length;
    badge.style.display = pending.length > 0 ? 'inline-flex' : 'none';

    if (!supportSessions.length) {
        list.innerHTML = '';
        list.appendChild(empty);
        empty.style.display = '';
        return;
    }
    empty.style.display = 'none';

    list.innerHTML = supportSessions.map(s => {
        const isActive = activeSupportSession === s.sessionId;
        const isMine = s.adminUserId === CURRENT_USER_ID;
        const isPending = !s.hasAdmin;
        const ago = timeSince(s.createdDate);
        const initial = (s.customerName || '?')[0].toUpperCase();
        const isOpen = openTabs.some(t => t.sessionId === s.sessionId);

        let action = '';
        if (isPending) {
            action = `<button class="btn btn-sm btn-soft-success support-take-btn" onclick="event.stopPropagation();takeSupport('${s.sessionId}')"><i class="ri-check-line me-1"></i>Al</button>`;
        } else if (isMine) {
            action = '<span class="badge bg-success-subtle text-success" style="font-size:.65rem;">Sizde</span>';
        } else {
            action = '<span class="badge bg-info-subtle text-info" style="font-size:.65rem;">Atandı</span>';
        }

        return `<div class="twc-support-item twc-material-tile${isActive ? ' twc-active' : ''}" onclick="openSupportChat('${s.sessionId}')">
            <div class="support-avatar">${initial}<span class="pulse-dot"></span></div>
            <div class="support-info">
                <p class="support-name">${escHtml(s.customerName || 'Müşteri')}${isOpen ? ' <i class="ri-window-line" style="font-size:.7rem;opacity:.5;" title="Sekmede açık"></i>' : ''}</p>
                <p class="support-detail">
                    <i class="ri-file-text-line"></i>${escHtml(s.orderName || '')}
                    <span style="color:var(--vz-text-muted)">•</span>
                    <span>#${s.invoiceId}</span>
                </p>
            </div>
            <div class="d-flex flex-column align-items-end gap-1">
                <span class="support-time">${ago}</span>
                ${action}
            </div>
        </div>`;
    }).join('');
}

function timeSince(dateStr) {
    const d = new Date(dateStr);
    const sec = Math.floor((Date.now() - d.getTime()) / 1000);
    if (sec < 60) return 'Şimdi';
    if (sec < 3600) return Math.floor(sec / 60) + 'dk';
    if (sec < 86400) return Math.floor(sec / 3600) + 'sa';
    return Math.floor(sec / 86400) + 'g';
}

function showSupportNotification(name) {
    if (Notification.permission === 'granted') {
        new Notification('Yeni Destek Talebi', { body: name + ' destek bekliyor', icon: '/admin/velzon-dist/assets/images/favicon.ico' });
    }
    if (typeof Swal !== 'undefined') {
        Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: 'Yeni destek: ' + name, showConfirmButton: false, timer: 4000 });
    }
}

async function takeSupport(sessionId) {
    if (!supportConnection) return;
    try {
        await supportConnection.invoke('TakeSupport', sessionId);
        openSupportChat(sessionId);
    } catch(e) { console.error('TakeSupport error:', e); }
}

function openSupportChat(sessionId) {
    const session = supportSessions.find(s => s.sessionId === sessionId);
    if (!session) return;

    switchTab('support');
    getOrCreateTab(sessionId);

    if (session.hasAdmin && session.adminUserId === CURRENT_USER_ID) {
        supportConnection.invoke('TakeSupport', sessionId).catch(() => {});
    }

    switchToTab(sessionId);
}

function updateVisitorPanel(data) {
    if (!data) return;
    document.getElementById('viIp').textContent = data.ipAddress || '—';
    const loc = [data.city, data.country].filter(Boolean).join(', ');
    document.getElementById('viLocation').textContent = loc || '—';
    document.getElementById('viIsp').textContent = data.isp || '—';
    document.getElementById('viPage').textContent = data.pageUrl || '—';
    document.getElementById('viDevice').textContent = parseUA(data.userAgent) || '—';
}

function parseUA(ua) {
    if (!ua) return '';
    let browser = '', os = '';
    if (ua.includes('Chrome') && !ua.includes('Edg')) browser = 'Chrome';
    else if (ua.includes('Firefox')) browser = 'Firefox';
    else if (ua.includes('Safari') && !ua.includes('Chrome')) browser = 'Safari';
    else if (ua.includes('Edg')) browser = 'Edge';
    else browser = 'Diğer';
    if (ua.includes('Windows')) os = 'Windows';
    else if (ua.includes('Mac OS')) os = 'macOS';
    else if (ua.includes('Android')) os = 'Android';
    else if (ua.includes('iPhone') || ua.includes('iPad')) os = 'iOS';
    else if (ua.includes('Linux')) os = 'Linux';
    else os = 'Bilinmeyen';
    const mobile = /Mobile|Android|iPhone|iPad/i.test(ua) ? ' (Mobil)' : ' (Masaüstü)';
    return browser + ' / ' + os + mobile;
}

function updateSessionTimer() {
    if (!activeSessionStartTime) return;
    const diff = Math.floor((Date.now() - activeSessionStartTime.getTime()) / 1000);
    const m = Math.floor(diff / 60);
    const s = diff % 60;
    const el = document.getElementById('viSessionTime');
    if (el) el.textContent = m + 'dk ' + s + 'sn';
}

function appendSupportMessage(sender, content, time) {
    const msgs = document.getElementById('chatMessages');
    const rowCls = sender === 'admin' ? 'twc-msg-row twc-msg-row-sent' : 'twc-msg-row twc-msg-row-recv';
    msgs.innerHTML += `<div class="${rowCls}"><div><div class="twc-bubble">${escHtml(content || '')}</div><div class="twc-msg-time">${formatTime(time || new Date())}</div></div></div>`;
}

function addSupportChatSystemMsg(text) {
    const msgs = document.getElementById('chatMessages');
    msgs.innerHTML += `<div class="twc-date-pill"><span>${escHtml(text)}</span></div>`;
    scrollToBottom();
}

// Override sendMessage for support
const _originalSendMessage = sendMessage;
sendMessage = async function() {
    if (activeSupportSession) {
        const input = document.getElementById('messageInput');
        const text = input.value.trim();
        if (!text) return;
        input.value = '';
        try {
            await supportConnection.invoke('SendSupportMessage', activeSupportSession, text);
        } catch(e) { console.error('Support send error:', e); }
        return;
    }
    return _originalSendMessage();
};

const msgInput = document.getElementById('messageInput');
if (msgInput) {
    msgInput.addEventListener('keydown', e => {
        if (activeSupportSession && supportConnection) {
            supportConnection.invoke('AdminTyping', activeSupportSession).catch(() => {});
        }
    });
}

// Restore state when switching to regular chat
const _originalSelectContact = selectContact;
selectContact = async function(userId) {
    activeSupportSession = null;
    document.getElementById('btnChatAttach')?.classList.remove('d-none');
    document.getElementById('visitorPanel').classList.remove('show');
    clearInterval(sessionTimerInterval);
    document.getElementById('livePreviewText').textContent = '';
    // Deactivate all chat tabs visually (keep them open)
    renderChatTabs();
    return _originalSelectContact(userId);
};

if (Notification.permission === 'default') Notification.requestPermission();

initSupportHub();
setInterval(() => renderSupportList(), 30000);
@if (openGuide) { <text>switchTab('guide');</text> }
</script>
