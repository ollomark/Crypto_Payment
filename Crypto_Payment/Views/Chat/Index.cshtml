@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mesajlar";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var currentUserName = User.Identity?.Name ?? "";
    var openGuide = ViewBag.OpenGuideTab as bool? ?? false;
}

<link rel="stylesheet" href="~/css/chat-tw-components.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/office-onboarding.css" asp-append-version="true" />
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        important: '#tw-chat-root',
        theme: {
            extend: {
                boxShadow: {
                    'material-1': '0 1px 2px 0 rgb(15 23 42 / 0.06), 0 1px 3px 0 rgb(15 23 42 / 0.08)',
                    'material-2': '0 4px 6px -1px rgb(15 23 42 / 0.09), 0 2px 4px -2px rgb(15 23 42 / 0.06)',
                    'material-3': '0 10px 15px -3px rgb(15 23 42 / 0.1), 0 4px 6px -4px rgb(15 23 42 / 0.05)',
                },
            },
        },
    };
</script>
<details class="twc-page-prompt mb-2">
    <summary class="text-muted small d-inline-flex align-items-center gap-1 py-1 user-select-none">
        <i class="ri-information-line fs-14"></i>
        <span>Arayüz notu</span>
        <span class="text-muted opacity-75">— tıklayarak göster / gizle</span>
    </summary>
    <div class="text-muted small mt-2 mb-0 ps-2 border-start border-2 border-secondary border-opacity-25">
        <strong>Tailwind</strong> ile statik materyal yüzeyler (gölge / kenar); <strong>üye listesi, destek satırları ve tablolar</strong> <code>twc-material-*</code> bileşenleriyle kart içinde gösterilir — CDN dinamik sınıf üretmediği için veri satırları <code>chat-tw-components.css</code> üzerindedir.
    </div>
</details>
<div id="tw-chat-root" class="twc-root rounded-2xl ring-1 ring-slate-200/80 bg-slate-50/50 p-1 mb-3">
<div class="twc-shell" id="chatWrapper">
    <!-- Sidebar -->
    <div class="twc-sidebar" id="chatSidebar">
        <div class="twc-tabs-row">
            <div class="twc-tab twc-tab-active" id="tabMessages" onclick="switchTab('messages')">
                <i class="ri-message-3-line me-1"></i>Mesajlar
            </div>
            <div class="twc-tab" id="tabSupport" onclick="switchTab('support')">
                <i class="ri-customer-service-2-line me-1"></i>Destek
                <span class="tab-badge" id="supportBadge">0</span>
            </div>
            <div class="twc-tab" id="tabGuide" onclick="switchTab('guide')">
                <i class="ri-compasses-2-line me-1"></i>Rehber
            </div>
        </div>

        <!-- Messages Tab -->
        <div class="twc-tab-panel twc-show" id="tabContentMessages">
            <div class="twc-material-inset">
                <div class="twc-search">
                    <input type="text" class="form-control form-control-sm" placeholder="Kullanıcı ara..." id="contactSearch" oninput="filterContacts()">
                </div>
                <div class="twc-contact-list" id="contactList" role="list" aria-label="Sohbet kullanıcıları">
                    <div class="twc-contact-empty"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor...</div>
                </div>
            </div>
        </div>

        <!-- Support Tab -->
        <div class="twc-tab-panel" id="tabContentSupport">
            <div class="twc-material-inset">
                <div class="twc-contact-list" id="supportList">
                    <div class="support-empty" id="supportEmpty">
                        <i class="ri-customer-service-2-line"></i>
                        <p>Bekleyen destek talebi yok</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Büro onboarding (chat içi) -->
        <div class="twc-tab-panel" id="tabContentGuide">
            <div class="twc-material-inset">
                <div class="twc-guide-panel">
                    @await Html.PartialAsync("_OfficeOnboardingWizard")
                </div>
            </div>
        </div>
    </div>

    <!-- Main Chat Area -->
    <div class="twc-main" id="chatMain">
        <div class="twc-tabs-bar" id="chatTabsBar"></div>

        <details class="twc-material-tips twc-saasko-ai-prompts mx-2 mt-2 mb-0 rounded-xl border border-slate-200/80 bg-white shadow-material-1 overflow-hidden open:shadow-material-2 transition-shadow">
            <summary class="flex items-center gap-2 px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                <i class="ri-magic-line text-violet-600 text-lg"></i>
                Saasko AI — prompt önerileri
                <span class="ms-auto text-xs font-normal text-slate-400">tıklayarak aç / kapat</span>
            </summary>
            <div class="px-3 pb-3 pt-2 border-t border-slate-100 bg-slate-50/60">
                <p class="text-xs text-slate-500 mb-3 leading-relaxed">Bu metinleri Saasko AI veya kullandığınız asistana yapıştırın; köşeli parantezli yerleri kendi verinizle doldurun. <strong>Varsayılan kapalı</strong> — başlığa tıklayarak açın.</p>

                <div class="twc-saasko-prompt-item">
                    <div class="text-xs font-semibold text-slate-700 mb-1"><i class="ri-user-line text-indigo-500 me-1"></i>Müşteri / cari özeti</div>
                    <pre id="saasko-prompt-1" class="twc-saasko-pre">Sen bir büro muhasebe asistanısın. Aşağıdaki müşteri bilgilerini ve son mesaj özetini oku. Türkçe olarak (1) kısa durum özeti 3-5 madde, (2) önerilen sonraki adımlar 2-4 madde yaz.

Müşteri: [Ad Soyad / firma]
E-posta: [...]
Son mesajlar / notlar:
[Buraya yapıştırın]</pre>
                    <button type="button" class="btn btn-sm btn-soft-primary py-0 px-2" onclick="copySaaskoAiPrompt('saasko-prompt-1')"><i class="ri-file-copy-line me-1"></i>Kopyala</button>
                </div>

                <div class="twc-saasko-prompt-item">
                    <div class="text-xs font-semibold text-slate-700 mb-1"><i class="ri-customer-service-2-line text-indigo-500 me-1"></i>Canlı destek yanıt taslağı</div>
                    <pre id="saasko-prompt-2" class="twc-saasko-pre">Profesyonel ve samimi bir tonda, Türkçe kısa bir canlı destek mesajı yaz (max 4-5 cümle). Konu: [müşteri sorunu]. Müşteri adı: [ad]. Çözüm veya net bilgi isteği belirt.</pre>
                    <button type="button" class="btn btn-sm btn-soft-primary py-0 px-2" onclick="copySaaskoAiPrompt('saasko-prompt-2')"><i class="ri-file-copy-line me-1"></i>Kopyala</button>
                </div>

                <div class="twc-saasko-prompt-item">
                    <div class="text-xs font-semibold text-slate-700 mb-1"><i class="ri-file-list-3-line text-indigo-500 me-1"></i>Fatura / tahsilat takibi</div>
                    <pre id="saasko-prompt-3" class="twc-saasko-pre">Aşağıdaki fatura listesini analiz et. Türkçe tablo veya madde listesi ile: bekleyenler, gecikenler, bu hafta hatırlatılacaklar. Veri:
[Buraya tablo veya liste yapıştırın]</pre>
                    <button type="button" class="btn btn-sm btn-soft-primary py-0 px-2" onclick="copySaaskoAiPrompt('saasko-prompt-3')"><i class="ri-file-copy-line me-1"></i>Kopyala</button>
                </div>

                <div class="twc-saasko-prompt-item twc-saasko-prompt-item--last">
                    <div class="text-xs font-semibold text-slate-700 mb-1"><i class="ri-calendar-check-line text-indigo-500 me-1"></i>Toplantı / sohbet özeti</div>
                    <pre id="saasko-prompt-4" class="twc-saasko-pre">Şu metinden yapılabilir aksiyonları, sorumlu kişi önerisini ve tarihleri çıkar. Türkçe madde madde yaz.

---
[Buraya sohbet veya notları yapıştırın]
---</pre>
                    <button type="button" class="btn btn-sm btn-soft-primary py-0 px-2" onclick="copySaaskoAiPrompt('saasko-prompt-4')"><i class="ri-file-copy-line me-1"></i>Kopyala</button>
                </div>

                <div class="pt-2 mt-3 border-top border-slate-200/90">
                    <div class="text-xs font-semibold text-slate-600 mb-2">Arayüz ipuçları</div>
                    <ul class="list-none m-0 space-y-1.5 text-xs text-slate-600 leading-relaxed">
                        <li class="flex gap-2"><i class="ri-table-line text-indigo-500 shrink-0 mt-0.5"></i><span><strong>Tablolar:</strong> Faturalar / Müşteriler / Giderler → <strong>Büyüt</strong> ile geniş görünüm.</span></li>
                        <li class="flex gap-2"><i class="ri-user-search-line text-indigo-500 shrink-0 mt-0.5"></i><span><strong>Üyeler:</strong> Sol sekme, kart listesi + arama.</span></li>
                        <li class="flex gap-2"><i class="ri-customer-service-2-line text-indigo-500 shrink-0 mt-0.5"></i><span><strong>Destek:</strong> <strong>Al</strong> ile oturum; sağ panel IP / cihaz.</span></li>
                    </ul>
                </div>
            </div>
        </details>

        <!-- Yardımcılar: hızlı linkler + mini tablolar; büyüt → modal -->
        <div class="twc-assist-bar" id="twcAssistBar">
            <div class="d-flex flex-wrap align-items-center gap-1 py-1 px-2">
                <span class="text-muted small me-1 d-none d-lg-inline">Hızlı</span>
                <a href="/" class="btn btn-sm btn-soft-primary">Panel</a>
                <a href="/customers" class="btn btn-sm btn-light border">Müşteri</a>
                <a href="/expenses" class="btn btn-sm btn-light border">Gider</a>
                <a href="/approvals" class="btn btn-sm btn-light border">Onay</a>
                <a href="/finance/report" class="btn btn-sm btn-light border">Finans</a>
                <a href="/personnel" class="btn btn-sm btn-light border d-none d-md-inline-block" id="twcLinkPersonnel">Personel</a>
                <div class="vr mx-1 d-none d-sm-block align-self-stretch my-1"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showAssistWidget('invoices')" title="Son faturalar tablosu"><i class="ri-file-list-3-line"></i><span class="d-none d-sm-inline"> Faturalar</span></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showAssistWidget('customers')" title="Müşteri listesi"><i class="ri-team-line"></i><span class="d-none d-sm-inline"> Müşteriler</span></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showAssistWidget('expenses')" title="Son gider kayıtları"><i class="ri-wallet-3-line"></i><span class="d-none d-sm-inline"> Giderler</span></button>
                <button type="button" class="btn btn-sm btn-soft-dark ms-auto" onclick="openAssistModal()" title="Seçili tabloyu büyük pencerede aç"><i class="ri-fullscreen-line"></i></button>
                <button type="button" class="btn btn-sm btn-link text-secondary p-1" id="btnAssistCollapse" onclick="toggleAssistPanelCollapse()" title="Tablo panelini aç/kapat"><i class="ri-layout-bottom-line" id="btnAssistCollapseIcon"></i></button>
            </div>
            <div class="twc-assist-panel-inner d-none" id="twcAssistPanelInner">
                <div class="twc-material-toolbar">
                    <span class="twc-toolbar-title" id="twcAssistTitle">—</span>
                    <div class="d-flex gap-1 align-items-center">
                        <button type="button" class="btn btn-sm btn-soft-primary py-0 px-2" onclick="openAssistModal()"><i class="ri-fullscreen-line me-1"></i>Büyüt</button>
                        <button type="button" class="btn btn-sm btn-link text-muted py-0" onclick="hideAssistPanel()" title="Kapat">×</button>
                    </div>
                </div>
                <div class="twc-assist-table-wrap twc-dg-wrap twc-material-embedded" id="twcAssistTableWrap">
                    <div class="text-muted small p-3" id="twcAssistPlaceholder">Yukarıdan bir tablo seçin veya hızlı link kullanın.</div>
                    <table class="twc-dg-table d-none" id="twcAssistTable" role="grid" aria-label="Yardımcı veri tablosu">
                        <thead><tr id="twcAssistThead"></tr></thead>
                        <tbody id="twcAssistTbody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="twc-empty mx-2 my-2 rounded-2xl border border-slate-200/70 bg-white/90 shadow-material-1 px-4" id="chatEmpty">
            <i class="ri-message-3-line fs-1 text-slate-300 mb-2"></i>
            <h6 class="text-slate-600 font-semibold">Mesajlaşmaya başlayın</h6>
            <p class="text-muted fs-13 mb-0 text-center">Sol panelden kullanıcı seçin veya <strong>Rehber</strong> ile panele alışın.</p>
        </div>
        <div class="twc-main-head d-none" id="chatHeader">
            <button class="btn btn-sm btn-ghost-secondary d-md-none me-1" onclick="showSidebar()"><i class="ri-arrow-left-s-line fs-18"></i></button>
            <div class="twc-avatar-ring">
                <div class="twc-avatar" id="chatHeaderAvatar" style="background:#4f46e5;">?</div>
                <span class="twc-dot twc-dot-offline" id="chatHeaderDot"></span>
            </div>
            <div>
                <p class="name mb-0" id="chatHeaderName">-</p>
                <span class="status-text text-muted" id="chatHeaderStatus">Çevrimdışı</span>
            </div>
        </div>
        <div class="twc-messages d-none" id="chatMessages"></div>
        <div class="twc-typing d-none" id="typingIndicator"></div>
        <div class="twc-input-row d-none" id="chatInputArea" style="position:relative;">
            <input type="file" id="fileInput" style="display:none" onchange="handleFileSelect(this)">
            <button type="button" id="btnChatAttach" class="btn btn-link text-slate-500 p-1" title="Dosya gönder" onclick="document.getElementById('fileInput').click()"><i class="ri-attachment-2 fs-5"></i></button>
            <input type="text" id="messageInput" placeholder="Mesajınızı yazın..." autocomplete="off">
            <button type="button" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width:38px;height:38px;" onclick="sendMessage()" title="Gönder"><i class="ri-send-plane-fill"></i></button>
        </div>
    </div>

    <!-- Visitor Info Panel (right side, support chat only) -->
    <div class="visitor-panel" id="visitorPanel">
        <div class="visitor-panel-header">
            <i class="ri-user-search-line"></i>
            <h6>Ziyaretçi Bilgileri</h6>
        </div>

        <div class="live-preview-block" id="livePreviewBlock" style="display:none;">
            <div class="vi-label"><i class="ri-eye-line"></i>Canlı Yazı Önizleme</div>
            <div class="live-preview-text" id="livePreviewText"></div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-timer-line"></i>Chatte Geçen Süre</div>
            <div class="vi-value session-timer" id="viSessionTime">0dk 0sn</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-global-line"></i>IP Adresi</div>
            <div class="vi-value mono" id="viIp">—</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-map-pin-2-line"></i>Konum</div>
            <div class="vi-value" id="viLocation">—</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-building-line"></i>ISP</div>
            <div class="vi-value" id="viIsp">—</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-links-line"></i>Geldiği Sayfa</div>
            <div class="vi-value" id="viPage" style="font-size:.75rem;">—</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-device-line"></i>Cihaz / Tarayıcı</div>
            <div class="vi-value" id="viDevice" style="font-size:.75rem;">—</div>
        </div>

        <div class="visitor-info-block">
            <div class="vi-label"><i class="ri-file-text-line"></i>Fatura Bilgisi</div>
            <div class="vi-value" id="viInvoice">—</div>
        </div>
    </div>

    <div class="modal fade" id="assistModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title fs-6" id="assistModalTitle">Yardımcı tablo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-0" id="assistModalBody">
                    <div class="p-4 text-center text-muted"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
function copySaaskoAiPrompt(elementId) {
    var el = document.getElementById(elementId);
    if (!el || !navigator.clipboard) return;
    var t = (el.textContent || '').trim();
    navigator.clipboard.writeText(t).then(function () {
        if (typeof Swal !== 'undefined') {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Prompt panoya kopyalandı', showConfirmButton: false, timer: 1400 });
        }
    }).catch(function () {});
}
const CURRENT_USER_ID = '@currentUserId';
const CURRENT_USER_NAME = '@currentUserName';
const avatarColors = ['#405189','#0ab39c','#f06548','#f7b84b','#299cdb','#6559cc','#e83e8c','#2b8a3e'];
function getColor(id) { let h=0; for(let i=0;i<id.length;i++)h=id.charCodeAt(i)+((h<<5)-h); return avatarColors[Math.abs(h)%avatarColors.length]; }
function getInitials(name) { return (name||'?').split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase(); }
function formatTime(d) { const dt=new Date(d); return dt.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'}); }
function formatDate(d) { return new Date(d).toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'}); }
function formatFileSize(b) { if(!b)return''; if(b<1024)return b+'B'; if(b<1048576)return(b/1024).toFixed(1)+'KB'; return(b/1048576).toFixed(1)+'MB'; }
function isImage(name) { return /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(name||''); }

let contacts = [];
let activeContactId = null;
let connection = null;
let typingTimer = null;

// SignalR connection
connection = new signalR.HubConnectionBuilder()
    .withUrl('/chatHub')
    .withAutomaticReconnect()
    .build();

connection.on('ReceiveMessage', msg => {
    if (msg.senderId === activeContactId) {
        appendMessage(msg, false);
        scrollToBottom();
        connection.invoke('MarkAsRead', msg.senderId).catch(()=>{});
    }
    playMessageSound();
    refreshContactList();
});

connection.on('MessageSent', msg => {
    appendMessage(msg, true);
    scrollToBottom();
    refreshContactList();
});

connection.on('OnlineUsers', ids => {
    ids.forEach(id => setContactOnline(id, true));
});

connection.on('UserOnline', id => setContactOnline(id, true));
connection.on('UserOffline', id => setContactOnline(id, false));

connection.on('MessagesRead', userId => {
    document.querySelectorAll('.twc-msg-row-sent .msg-read-status').forEach(el => {
        el.innerHTML = '<i class="ri-check-double-line text-info"></i>';
    });
});

connection.on('UserTyping', senderId => {
    if (senderId === activeContactId) {
        const el = document.getElementById('typingIndicator');
        const contact = contacts.find(c => c.id === senderId);
        el.textContent = (contact?.name || 'Kullanıcı') + ' yazıyor...';
        el.classList.remove('d-none');
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => el.classList.add('d-none'), 2500);
    }
});

connection.start().then(() => {
    loadContacts();
}).catch(err => {
    console.error('SignalR bağlantı hatası:', err);
    loadContacts();
});

async function loadContacts() {
    try {
        const r = await fetch('/api/chat/contacts');
        if (!r.ok) return;
        contacts = await r.json();
        renderContacts();
    } catch(e) { console.error(e); }
}

async function refreshContactList() {
    try {
        const r = await fetch('/api/chat/contacts');
        if (!r.ok) return;
        contacts = await r.json();
        renderContacts();
    } catch(e) {}
}

function renderContacts() {
    const list = document.getElementById('contactList');
    const q = (document.getElementById('contactSearch')?.value || '').toLowerCase();
    const filtered = q ? contacts.filter(c => c.name.toLowerCase().includes(q) || (c.email||'').toLowerCase().includes(q)) : contacts;

    if (!filtered.length) {
        list.innerHTML = '<div class="twc-contact-empty">Kullanıcı bulunamadı</div>';
        return;
    }

    list.innerHTML = filtered.map(c => {
        const color = getColor(c.id);
        const initials = getInitials(c.name);
        const isActive = c.id === activeContactId;
        const preview = c.lastMessage ? (c.lastMessage.length > 30 ? c.lastMessage.substring(0,30)+'...' : c.lastMessage) : 'Henüz mesaj yok';
        const timeStr = c.lastDate ? formatTime(c.lastDate) : '';
        const unread = c.unreadCount > 0 ? `<span class="twc-unread-badge">${c.unreadCount}</span>` : '';
        return `<div class="twc-contact twc-material-tile${isActive ? ' twc-active' : ''}" role="listitem" onclick="selectContact('${c.id}')">
            <div class="twc-avatar-ring">
                <div class="twc-avatar" style="background:${color}">${initials}</div>
                <span class="twc-dot ${c.isOnline ? 'twc-dot-online' : 'twc-dot-offline'}" data-user-dot="${c.id}"></span>
            </div>
            <div class="twc-contact-body">
                <p class="twc-contact-name">${escHtml(c.name)}</p>
                <p class="twc-contact-preview">${escHtml(preview)}</p>
            </div>
            <div class="twc-contact-meta">
                <span class="twc-contact-time">${timeStr}</span>
                ${unread}
            </div>
        </div>`;
    }).join('');
}

function filterContacts() { renderContacts(); }

function setContactOnline(userId, online) {
    const c = contacts.find(x => x.id === userId);
    if (c) c.isOnline = online;
    const dot = document.querySelector(`[data-user-dot="${userId}"]`);
    if (dot) { dot.className = 'twc-dot ' + (online ? 'twc-dot-online' : 'twc-dot-offline'); }
    if (userId === activeContactId) {
        const hDot = document.getElementById('chatHeaderDot');
        const hStatus = document.getElementById('chatHeaderStatus');
        if (hDot) hDot.className = 'twc-dot ' + (online ? 'twc-dot-online' : 'twc-dot-offline');
        if (hStatus) { hStatus.textContent = online ? 'Çevrimiçi' : 'Çevrimdışı'; hStatus.className = 'status-text ' + (online ? 'text-success' : 'text-muted'); }
    }
}

async function selectContact(userId) {
    switchTab('messages');
    activeContactId = userId;
    const contact = contacts.find(c => c.id === userId);
    if (!contact) return;

    document.getElementById('chatEmpty').classList.add('d-none');
    document.getElementById('chatHeader').classList.remove('d-none');
    document.getElementById('chatMessages').classList.remove('d-none');
    document.getElementById('chatInputArea').classList.remove('d-none');
    document.getElementById('typingIndicator').classList.remove('d-none');
    document.getElementById('typingIndicator').textContent = '';

    const color = getColor(contact.id);
    document.getElementById('chatHeaderAvatar').style.background = color;
    document.getElementById('chatHeaderAvatar').textContent = getInitials(contact.name);
    document.getElementById('chatHeaderName').textContent = contact.name;
    document.getElementById('chatHeaderDot').className = 'twc-dot ' + (contact.isOnline ? 'twc-dot-online' : 'twc-dot-offline');
    document.getElementById('chatHeaderStatus').textContent = contact.isOnline ? 'Çevrimiçi' : 'Çevrimdışı';
    document.getElementById('chatHeaderStatus').className = 'status-text ' + (contact.isOnline ? 'text-success' : 'text-muted');

    renderContacts();

    // Load history
    const msgs = document.getElementById('chatMessages');
    msgs.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm"></span></div>';

    try {
        const r = await fetch('/api/chat/history/' + userId);
        if (!r.ok) { msgs.innerHTML = '<p class="text-muted text-center">Yüklenemedi</p>'; return; }
        const history = await r.json();
        msgs.innerHTML = '';
        let lastDate = '';
        history.forEach(m => {
            const d = formatDate(m.createdDate);
            if (d !== lastDate) {
                lastDate = d;
                msgs.innerHTML += `<div class="twc-date-pill"><span>${d}</span></div>`;
            }
            appendMessage(m, m.senderId === CURRENT_USER_ID);
        });
        scrollToBottom();
        connection.invoke('MarkAsRead', userId).catch(()=>{});
        contact.unreadCount = 0;
        renderContacts();
    } catch(e) { msgs.innerHTML = '<p class="text-muted text-center">Hata oluştu</p>'; }

    // Mobile: hide sidebar
    document.getElementById('chatSidebar').classList.add('twc-hidden');
    document.getElementById('messageInput').focus();
}

function appendMessage(msg, isSent) {
    const msgs = document.getElementById('chatMessages');
    const rowCls = isSent ? 'twc-msg-row twc-msg-row-sent' : 'twc-msg-row twc-msg-row-recv';
    let content = '';

    if (msg.fileUrl) {
        if (isImage(msg.fileName)) {
            content = `<img src="${msg.fileUrl}" alt="${msg.fileName||'image'}" class="msg-img-preview" onclick="window.open('${msg.fileUrl}','_blank')">`;
        } else {
            content = `<a href="${msg.fileUrl}" target="_blank" class="msg-file-attachment">
                <i class="ri-file-line"></i>
                <div><div class="msg-file-name">${msg.fileName||'Dosya'}</div><div class="msg-file-size">${formatFileSize(msg.fileSize)}</div></div>
            </a>`;
        }
        if (msg.content) content += `<div class="mt-1">${escHtml(msg.content)}</div>`;
    } else {
        content = escHtml(msg.content || '');
    }

    msgs.innerHTML += `<div class="${rowCls}">
        <div>
            <div class="twc-bubble">${content}</div>
            <div class="twc-msg-time">${formatTime(msg.createdDate)} ${isSent ? '<span class="msg-read-status ms-1"><i class="ri-check-line"></i></span>' : ''}</div>
        </div>
    </div>`;
}

function escHtml(s) { const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

// ───── Sohbet yardımcıları: hızlı linkler + mini datagrid + modal büyütme ─────
let currentAssistKind = null;

function formatAssistMoney(n) {
    if (n == null || n === '') return '—';
    const x = Number(n);
    if (Number.isNaN(x)) return escHtml(String(n));
    return x.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function formatAssistDate(d) {
    try { return new Date(d).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
    catch { return '—'; }
}

function renderAssistTable(headers, rows) {
    const ph = document.getElementById('twcAssistPlaceholder');
    const tbl = document.getElementById('twcAssistTable');
    const thead = document.getElementById('twcAssistThead');
    const tbody = document.getElementById('twcAssistTbody');
    if (!thead || !tbody) return;
    thead.innerHTML = headers.map(h => '<th scope="col">' + escHtml(h) + '</th>').join('');
    tbody.innerHTML = rows.map(cells => '<tr>' + cells.map(c => '<td>' + c + '</td>').join('') + '</tr>').join('');
    ph.classList.add('d-none');
    tbl.classList.remove('d-none');
    tbl.classList.add('twc-dg-table');
}

function showAssistError(msg) {
    const ph = document.getElementById('twcAssistPlaceholder');
    const tbl = document.getElementById('twcAssistTable');
    ph.textContent = msg;
    ph.classList.remove('d-none');
    tbl.classList.add('d-none');
}

function showAssistWidget(kind) {
    currentAssistKind = kind;
    const inner = document.getElementById('twcAssistPanelInner');
    inner.classList.remove('d-none');
    updateAssistCollapseIcon();
    const title = document.getElementById('twcAssistTitle');
    const ph = document.getElementById('twcAssistPlaceholder');
    document.getElementById('twcAssistTable').classList.add('d-none');
    ph.classList.remove('d-none');
    ph.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Yükleniyor...';

    if (kind === 'invoices') {
        title.textContent = 'Son faturalar';
        fetch('/api/invoices/GetAll', { credentials: 'include' })
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(list => {
                const arr = Array.isArray(list) ? list : [];
                arr.sort((a, b) => new Date(b.createdDate || 0) - new Date(a.createdDate || 0));
                const slice = arr.slice(0, 40);
                renderAssistTable(
                    ['Sipariş', 'Tutar', 'PB', 'Durum', 'Tarih'],
                    slice.map(inv => [
                        escHtml((inv.orderName || '—').substring(0, 38)),
                        formatAssistMoney(inv.sourceAmount),
                        escHtml(inv.sourceCurrency || ''),
                        escHtml(inv.status || ''),
                        inv.createdDate ? formatAssistDate(inv.createdDate) : '—'
                    ])
                );
            })
            .catch(() => showAssistError('Faturalar yüklenemedi veya yetkiniz yok.'));
    } else if (kind === 'customers') {
        title.textContent = 'Müşteriler';
        fetch('/api/customers/GetAll', { credentials: 'include' })
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(list => {
                const arr = Array.isArray(list) ? list : [];
                const slice = arr.slice(0, 40);
                renderAssistTable(
                    ['Firma / Ad', 'E-posta', 'Telefon'],
                    slice.map(c => {
                        const name = c.companyName || [c.firstName, c.lastName].filter(Boolean).join(' ') || '—';
                        return [
                            escHtml((name || '').substring(0, 36)),
                            escHtml((c.email || '—').substring(0, 30)),
                            escHtml((c.phone || '—').toString().substring(0, 18))
                        ];
                    })
                );
            })
            .catch(() => showAssistError('Müşteriler yüklenemedi veya yetkiniz yok.'));
    } else if (kind === 'expenses') {
        title.textContent = 'Gider kayıtları';
        fetch('/api/expenses', { credentials: 'include' })
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(list => {
                const arr = Array.isArray(list) ? list : [];
                arr.sort((a, b) => new Date(b.createdDate || 0) - new Date(a.createdDate || 0));
                const slice = arr.slice(0, 40);
                renderAssistTable(
                    ['Açıklama', 'Tutar', 'Durum', 'Tarih'],
                    slice.map(e => [
                        escHtml((e.description || '—').substring(0, 34)),
                        formatAssistMoney(e.amount) + ' ' + escHtml(e.currency || ''),
                        escHtml(e.status || ''),
                        e.createdDate ? formatAssistDate(e.createdDate) : '—'
                    ])
                );
            })
            .catch(() => showAssistError('Giderler yüklenemedi veya yetkiniz yok.'));
    }
}

function hideAssistPanel() {
    document.getElementById('twcAssistPanelInner').classList.add('d-none');
    updateAssistCollapseIcon();
}

function toggleAssistPanelCollapse() {
    document.getElementById('twcAssistPanelInner').classList.toggle('d-none');
