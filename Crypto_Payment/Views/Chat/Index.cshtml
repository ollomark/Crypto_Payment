function buildAssistTableHtml(headers, rows) {
    const h = '<thead><tr>' + headers.map(x => '<th scope="col">' + escHtml(x) + '</th>').join('') + '</tr></thead>';
    const b = '<tbody>' + rows.map(cells => '<tr>' + cells.map(c => '<td>' + c + '</td>').join('') + '</tr>').join('') + '</tbody>';
    return '<div class="twc-dg-wrap twc-dg-modal"><table class="twc-dg-table" role="grid">' + h + b + '</table></div>';
}

function openAssistModal() {
    if (!currentAssistKind) {
        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'info', title: 'Önce tablo seçin', text: 'Faturalar, Müşteriler veya Giderler düğmesine tıklayın.' });
        else alert('Önce bir tablo seçin.');
        return;
    }
    document.getElementById('assistModalTitle').textContent = document.getElementById('twcAssistTitle').textContent + ' — geniş görünüm';
    const body = document.getElementById('assistModalBody');
    body.innerHTML = '<div class="p-4 text-center"><span class="spinner-border"></span></div>';
    const m = bootstrap.Modal.getOrCreateInstance(document.getElementById('assistModal'));
    m.show();
    loadAssistModalBody(currentAssistKind);
}

async function loadAssistModalBody(kind) {
    const body = document.getElementById('assistModalBody');
    const limit = 200;
    try {
        if (kind === 'invoices') {
            const r = await fetch('/api/invoices/GetAll', { credentials: 'include' });
            if (!r.ok) throw new Error();
            const list = await r.json();
            const arr = (Array.isArray(list) ? list : []).sort((a, b) => new Date(b.createdDate || 0) - new Date(a.createdDate || 0)).slice(0, limit);
            const rows = arr.map(inv => [
                escHtml(inv.orderName || '—'),
                formatAssistMoney(inv.sourceAmount),
                escHtml(inv.sourceCurrency || ''),
                escHtml(inv.status || ''),
                inv.createdDate ? formatAssistDate(inv.createdDate) : '—',
                escHtml(inv.id != null ? String(inv.id) : '—')
            ]);
            body.innerHTML = buildAssistTableHtml(['Sipariş', 'Tutar', 'PB', 'Durum', 'Tarih', 'No'], rows);
        } else if (kind === 'customers') {
            const r = await fetch('/api/customers/GetAll', { credentials: 'include' });
            if (!r.ok) throw new Error();
            const list = await r.json();
            const arr = (Array.isArray(list) ? list : []).slice(0, limit);
            const rows = arr.map(c => {
                const name = c.companyName || [c.firstName, c.lastName].filter(Boolean).join(' ') || '—';
                return [
                    escHtml(name),
                    escHtml(c.email || '—'),
                    escHtml((c.phone || '—').toString()),
                    escHtml(c.id != null ? String(c.id) : '—')
                ];
            });
            body.innerHTML = buildAssistTableHtml(['Firma / Ad', 'E-posta', 'Telefon', 'No'], rows);
        } else if (kind === 'expenses') {
            const r = await fetch('/api/expenses', { credentials: 'include' });
            if (!r.ok) throw new Error();
            const list = await r.json();
            const arr = (Array.isArray(list) ? list : []).sort((a, b) => new Date(b.createdDate || 0) - new Date(a.createdDate || 0)).slice(0, limit);
            const rows = arr.map(e => [
                escHtml(e.description || '—'),
                formatAssistMoney(e.amount) + ' ' + escHtml(e.currency || ''),
                escHtml(e.category || ''),
                escHtml(e.status || ''),
                e.createdDate ? formatAssistDate(e.createdDate) : '—'
            ]);
            body.innerHTML = buildAssistTableHtml(['Açıklama', 'Tutar', 'Kategori', 'Durum', 'Tarih'], rows);
        }
    } catch {
        body.innerHTML = '<p class="p-3 text-danger mb-0">Veri yüklenemedi.</p>';
    }
}

function scrollToBottom() {
    const el = document.getElementById('chatMessages');
    requestAnimationFrame(() => el.scrollTop = el.scrollHeight);
}

async function sendMessage() {
    const input = document.getElementById('messageInput');
    const text = input.value.trim();
    if (!text || !activeContactId) return;
    input.value = '';
    try {
        await connection.invoke('SendMessage', activeContactId, text);
    } catch(e) { console.error('Mesaj gönderilemedi:', e); }
}

document.getElementById('messageInput')?.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
    if (activeContactId) {
        connection.invoke('Typing', activeContactId).catch(()=>{});
    }
});

async function handleFileSelect(input) {
    const file = input.files[0];
    if (!file || !activeContactId) return;
    input.value = '';

    if (file.size > 10 * 1024 * 1024) {
        alert('Dosya 10MB\'dan büyük olamaz');
        return;
    }

    const fd = new FormData();
    fd.append('file', file);

    const msgs = document.getElementById('chatMessages');
    const placeholder = document.createElement('div');
    placeholder.className = 'twc-msg-row twc-msg-row-sent';
    placeholder.innerHTML = `<div><div class="twc-bubble"><span class="spinner-border spinner-border-sm me-2"></span>Dosya yükleniyor...</div></div>`;
    msgs.appendChild(placeholder);
    scrollToBottom();

    try {
        const r = await fetch('/api/chat/upload', { method:'POST', body:fd });
        if (!r.ok) { placeholder.remove(); alert('Dosya yüklenemedi'); return; }
        const data = await r.json();
        placeholder.remove();
        await connection.invoke('SendFileMessage', activeContactId, data.url, data.fileName, data.fileSize);
    } catch(e) { placeholder.remove(); alert('Dosya gönderim hatası'); }
}

function showSidebar() {
    document.getElementById('chatSidebar').classList.remove('twc-hidden');
}

// Drag & drop
const chatMain = document.getElementById('chatMain');
let dropOverlay = null;

chatMain.addEventListener('dragover', e => {
    e.preventDefault();
    if (!activeContactId) return;
    if (!dropOverlay) {
        dropOverlay = document.createElement('div');
        dropOverlay.className = 'twc-drop';
        dropOverlay.innerHTML = '<span><i class="ri-upload-cloud-2-line me-2"></i>Dosyayı bırakın</span>';
        chatMain.style.position = 'relative';
        chatMain.appendChild(dropOverlay);
    }
});

chatMain.addEventListener('dragleave', e => {
    if (e.relatedTarget && chatMain.contains(e.relatedTarget)) return;
    dropOverlay?.remove();
    dropOverlay = null;
});

chatMain.addEventListener('drop', e => {
    e.preventDefault();
    dropOverlay?.remove();
    dropOverlay = null;
    if (!activeContactId) return;
    const file = e.dataTransfer.files[0];
    if (file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        document.getElementById('fileInput').files = dt.files;
        handleFileSelect(document.getElementById('fileInput'));
    }
});

