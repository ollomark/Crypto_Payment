@{
    ViewBag.Title = "Fatura Oluştur";
    Layout = "_Layout";
}

<!-- Skeleton Placeholder -->
<div class="container-fluid" id="page-skeleton">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-breadcrumb"></div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-xxl-9">
            <div class="card">
                <div class="card-body p-4">
                    <div class="row g-3">
                        @for (int sk = 0; sk < 4; sk++)
                        {
                        <div class="col-lg-3 col-sm-6">
                            <div class="skeleton skeleton-text-sm" style="width:80px;margin-bottom:8px;"></div>
                            <div class="skeleton" style="width:100%;height:38px;border-radius:6px;"></div>
                        </div>
                        }
                    </div>
                    <div class="row g-3 mt-3">
                        @for (int sk = 0; sk < 3; sk++)
                        {
                        <div class="col-lg-4 col-sm-6">
                            <div class="skeleton skeleton-text-sm" style="width:80px;margin-bottom:8px;"></div>
                            <div class="skeleton" style="width:100%;height:38px;border-radius:6px;"></div>
                        </div>
                        }
                    </div>
                    <div class="table-responsive mt-4">
                        <table class="table mb-0"><tbody>
                            @for (int sk = 0; sk < 3; sk++)
                            {
                            <tr>
                                <td><div class="skeleton skeleton-text" style="width:150px;"></div></td>
                                <td><div class="skeleton" style="width:60px;height:30px;border-radius:4px;"></div></td>
                                <td><div class="skeleton" style="width:80px;height:30px;border-radius:4px;"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:70px;"></div></td>
                            </tr>
                            }
                        </tbody></table>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <div class="skeleton skeleton-btn" style="width:120px;"></div>
                        <div class="skeleton skeleton-btn" style="width:120px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid" id="page-real" style="display:none;">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                <h4 class="mb-sm-0">Fatura Oluştur</h4>

                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Faturalar</a></li>
                        <li class="breadcrumb-item active">Fatura Oluştur</li>
                    </ol>
                </div>

            </div>
        </div>
    </div>
    <!-- end page title -->

    <div class="row justify-content-center">
        <div class="col-xxl-9">
            <div class="card">
                <form class="needs-validation" novalidate id="invoice_form">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-lg-3 col-sm-6">
                                <label for="invoiceNo">Fatura No</label>
                                <input type="text" class="form-control bg-light border-0" id="invoiceNo" placeholder="Fatura No" value="#VL25000355" readonly="readonly" />
                            </div>
                            <!--end col-->
                            <div class="col-lg-3 col-sm-6">
                                <label for="choices-customer">Müşteri</label>
                                <div class="input-group">
                                    <select class="form-control bg-light border-0" id="choices-customer" required>
                                        <option value="">Müşteri Seçin</option>
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary" id="btnNewCustomer" title="Yeni Müşteri Ekle" data-bs-toggle="modal" data-bs-target="#newCustomerModal">
                                        <i class="ri-user-add-line"></i>
                                    </button>
                                </div>
                            </div>
                            <!--end col-->
                            <div class="col-lg-3 col-sm-6">
                                <label for="choices-currency">Para Birimi</label>
                                <div class="input-light">
                                    <select class="form-control bg-light border-0" id="choices-currency" required>
                                        <option value="">Bir Para Birimi Seçin</option>
                                        <option value="USDT_TRX">USDT_TRX</option>
                                        <option value="TRX">TRX</option>
                                        <option value="BTC">BTC</option>
                                        <option value="ETH">ETH</option>
                                    </select>
                                </div>
                            </div>
                            <!--end col-->
                            <div class="col-lg-3 col-sm-6">
                                <label for="choices-source-currency">Gerçek Para Birimi</label>
                                <div class="input-light">
                                    <select class="form-control bg-light border-0" id="choices-source-currency" required>
                                        <option value="">Gerçek Bir Para Birimi Seçin</option>
                                        <option value="USD">USD</option>
                                        <option value="EURO">EURO</option>
                                        <option value="TL">TL</option>
                                    </select>
                                </div>
                            </div>
                            <!--end col-->
                        </div>
                        <!--end row-->
                        
                        <div class="row g-3 mt-2">
                            <div class="col-lg-3 col-sm-6">
                                <label for="orderName">Sipariş Adı</label>
                                <input type="text" class="form-control bg-light border-0" id="orderName" placeholder="Sipariş Adı" required />
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <label for="email">E-posta</label>
                                <input type="email" class="form-control bg-light border-0" id="email" placeholder="ornek@email.com" required />
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <label for="callbackUrl">Callback URL</label>
                                <input type="url" class="form-control bg-light border-0" id="callbackUrl" placeholder="https://..." value="" />
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <label for="sourceAmount">Toplam Tutar</label>
                                <input type="number" step="0.01" class="form-control bg-light border-0" id="sourceAmount" placeholder="0.00" required />
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-lg-4 col-sm-6">
                                <label class="form-label fw-medium">Fatura Türü</label>
                                <div class="d-flex gap-3 mt-1">
                                    <div class="form-check form-radio-primary">
                                        <input class="form-check-input" type="radio" name="invoiceType" id="typeOneTime" value="onetime" checked>
                                        <label class="form-check-label" for="typeOneTime">
                                            <i class="ri-file-text-line me-1"></i>Tek Seferlik
                                        </label>
                                    </div>
                                    <div class="form-check form-radio-success">
                                        <input class="form-check-input" type="radio" name="invoiceType" id="typeRecurring" value="recurring">
                                        <label class="form-check-label" for="typeRecurring">
                                            <i class="ri-repeat-line me-1"></i>Yinelenen
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-6" id="recurringDayWrapper" style="display:none;">
                                <label for="recurringDay" class="form-label fw-medium">Ayın Kaçıncı Günü? <span class="text-danger">*</span></label>
                                <select class="form-select bg-light border-0" id="recurringDay">
                                    @for (int d = 1; d <= 28; d++)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                                <small class="text-muted">Her ay bu günde hatırlatma gönderilir</small>
                            </div>
                        </div>
                        <!--end row-->
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="invoice-table table table-borderless table-nowrap mb-0">
                                <thead class="align-middle">
                                    <tr class="table-active">
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">Ürün Adı</th>
                                        <th scope="col" style="width: 120px;">Birim Fiyat</th>
                                        <th scope="col" style="width: 120px;">Adet</th>
                                        <th scope="col" class="text-end" style="width: 150px;">Tutar</th>
                                        <th scope="col" class="text-end" style="width: 105px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="newlink">
                                    <tr id="1" class="product">
                                        <th scope="row" class="product-id">1</th>
                                        <td class="text-start">
                                            <div class="mb-2">
                                                <input type="text" class="form-control bg-light border-0" id="productName-1" placeholder="Ürün Adı" required />
                                            </div>
                                            <textarea class="form-control bg-light border-0" id="productDetails-1" rows="2" placeholder="Ürün Detayları"></textarea>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control product-price bg-light border-0" id="productRate-1" step="0.01" placeholder="0.00" required onchange="calculateTotal()" />
                                        </td>
                                        <td>
                                            <div class="input-step">
                                                <button type="button" class='minus' onclick="decreaseQty(1)">–</button>
                                                <input type="number" class="product-quantity" id="product-qty-1" value="1" min="1" onchange="calculateTotal()">
                                                <button type="button" class='plus' onclick="increaseQty(1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <div>
                                                <input type="text" class="form-control bg-light border-0 product-line-price" id="productPrice-1" placeholder="€0.00" readonly />
                                            </div>
                                        </td>
                                        <td class="product-removal">
                                            <a href="javascript:void(0)" class="btn btn-danger" onclick="removeProduct(1)">Sil</a>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody>
                                    <tr id="newForm" style="display: none;"><td class="d-none" colspan="5"><p>Add New Form</p></td></tr>
                                    <tr>
                                        <td colspan="5">
                                            <a href="javascript:addNewProduct()" id="add-item" class="btn btn-soft-secondary fw-medium"><i class="ri-add-fill me-1 align-bottom"></i> Ürün Ekle</a>
                                        </td>
                                    </tr>
                                    <tr class="border-top border-top-dashed mt-2">
                                        <td colspan="3"></td>
                                        <td colspan="3" class="p-0">
                                            <table class="table table-borderless table-sm table-nowrap align-middle mb-0">
                                                <tbody>
                                                    <tr>
                                                        <th scope="row">Ara Toplam</th>
                                                        <td style="width:150px;">
                                                            <input type="text" class="form-control bg-light border-0" id="cart-subtotal" placeholder="€0.00" readonly />
                                                        </td>
                                                    </tr>

                                                    <tr class="border-top border-top-dashed">
                                                        <th scope="row">Toplam Tutar</th>
                                                        <td>
                                                            <input type="text" class="form-control bg-light border-0" id="cart-total" placeholder="€0.00" readonly />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4">
                            <label for="notes" class="form-label text-muted text-uppercase fw-semibold">NOTLAR</label>
                            <textarea class="form-control alert alert-info" id="notes" placeholder="Notlar" rows="2">Tüm ödemeler fatura tarihinden itibaren 7 gün içinde yapılmalıdır.</textarea>
                        </div>
                        <div class="hstack gap-2 justify-content-end d-print-none mt-4">
                            <button type="submit" class="btn btn-success"><i class="ri-save-line align-bottom me-1"></i> Fatura Oluştur</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Loading Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <p class="mt-3 mb-0">Fatura oluşturuluyor, lütfen bekleyin...</p>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <i class="ri-checkbox-circle-line text-success" style="font-size: 64px;"></i>
                <h4 class="mt-3">Fatura Başarıyla Oluşturuldu!</h4>
                <p id="successMessage" class="text-muted"></p>
                <a href="/invoices" class="btn btn-primary mt-3">Faturalara Git</a>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <i class="ri-close-circle-line text-danger" style="font-size: 64px;"></i>
                <h4 class="mt-3">Hata Oluştu!</h4>
                <p id="errorMessage" class="text-muted"></p>
                <button type="button" class="btn btn-secondary mt-3" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Yeni Müşteri Ekle Modal -->
<div class="modal fade" id="newCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-info-subtle p-3">
                <h5 class="modal-title">Müşteri Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form id="newCustomerForm" class="tablelist-form" autocomplete="off">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-lg-12">
                            <div class="text-center">
                                <div class="position-relative d-inline-block">
                                    <div class="position-absolute bottom-0 end-0">
                                        <label for="nc-image-input" class="mb-0" data-bs-toggle="tooltip" data-bs-placement="right" title="Fotoğraf Seç">
                                            <div class="avatar-xs cursor-pointer">
                                                <div class="avatar-title bg-light border rounded-circle text-muted">
                                                    <i class="ri-image-fill"></i>
                                                </div>
                                            </div>
                                        </label>
                                        <input class="form-control d-none" id="nc-image-input" type="file" accept="image/png, image/gif, image/jpeg">
                                    </div>
                                    <div class="avatar-lg p-1">
                                        <div class="avatar-title bg-light rounded-circle">
                                            <img src="/admin/velzon-dist/assets/images/users/user-dummy-img.jpg" id="nc-img" class="avatar-md rounded-circle object-fit-cover" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustFirstName" class="form-label">Ad</label>
                            <input type="text" id="newCustFirstName" class="form-control" placeholder="Adı Girin" required />
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustLastName" class="form-label">Soyad</label>
                            <input type="text" id="newCustLastName" class="form-control" placeholder="Soyadı Girin" required />
                        </div>
                        <div class="col-lg-12">
                            <label for="newCustCompany" class="form-label">Şirket Adı</label>
                            <input type="text" id="newCustCompany" class="form-control" placeholder="Şirket Adını Girin" />
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustEmail" class="form-label">E-Posta</label>
                            <input type="email" id="newCustEmail" class="form-control" placeholder="E-Posta Girin" />
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustPhone" class="form-label">Telefon</label>
                            <input type="text" id="newCustPhone" class="form-control" placeholder="Tel No Girin" required />
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustTelegram" class="form-label">Telegram</label>
                            <input type="text" id="newCustTelegram" class="form-control" placeholder="Telegram Adresi Girin" />
                        </div>
                        <div class="col-lg-6">
                            <label for="newCustSkype" class="form-label">Skype</label>
                            <input type="text" id="newCustSkype" class="form-control" placeholder="Skype Adresi Girin" />
                        </div>
                        <div class="col-lg-12">
                            <div id="newCustApiError" class="alert alert-danger d-none"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Kapat</button>
                        <button type="submit" class="btn btn-success">Müşteri Ekle</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let productCount = 1;
    let customers = [];
    const items = [];

    const currencySymbols = {
        'USD': '$',
        'EURO': '\u20ac',
        'EUR': '\u20ac',
        'TL': '\u20ba',
        'TRY': '\u20ba',
        'GBP': '\u00a3',
    };

    function getCurrencySymbol() {
        const sc = document.getElementById('choices-source-currency')?.value || 'USD';
        return currencySymbols[sc.toUpperCase()] || sc;
    }

    function updateAllSymbols() {
        const sym = getCurrencySymbol();
        document.querySelectorAll('.product-line-price').forEach(el => {
            const num = parseFloat(el.value.replace(/[^0-9.\-]/g, '')) || 0;
            el.value = sym + formatMoney(num);
        });
        const sub = parseFloat(document.getElementById('cart-subtotal').value.replace(/[^0-9.\-]/g, '')) || 0;
        const tot = parseFloat(document.getElementById('cart-total').value.replace(/[^0-9.\-]/g, '')) || 0;
        document.getElementById('cart-subtotal').value = sym + formatMoney(sub);
        document.getElementById('cart-total').value = sym + formatMoney(tot);
    }

    // Sayfa yüklendiğinde
    document.addEventListener('DOMContentLoaded', function() {
        // Skeleton kaldır, gerçek içeriği göster
        var skel = document.getElementById('page-skeleton');
        var real = document.getElementById('page-real');
        if (skel) skel.remove();
        if (real) real.style.display = '';

        var callbackInput = document.getElementById('callbackUrl');
        if (callbackInput && !callbackInput.value) {
            callbackInput.value = window.location.origin + '/api/callback';
        }
        loadCustomers();
        calculateTotal();

        document.getElementById('choices-source-currency')?.addEventListener('change', function() {
            calculateTotal();
        });

        document.querySelectorAll('input[name="invoiceType"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const wrapper = document.getElementById('recurringDayWrapper');
                wrapper.style.display = this.value === 'recurring' ? '' : 'none';
            });
        });
    });

    // Müşterileri API'den yükle
    async function loadCustomers() {
        try {
            const response = await fetch('/api/customers/GetAll');
            if (response.ok) {
                customers = await response.json();
                const select = document.getElementById('choices-customer');
                
                customers.forEach(customer => {
                    const option = document.createElement('option');
                    option.value = customer.id;
                    option.textContent = `${customer.firstName} ${customer.lastName}${customer.companyName ? ' - ' + customer.companyName : ''}`;
                    option.dataset.email = customer.email || '';
                    select.appendChild(option);
                });
            }
        } catch (error) {
            console.error('Müşteriler yüklenirken hata:', error);
        }
    }

    // Müşteri seçildiğinde email'i otomatik doldur
    document.getElementById('choices-customer').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const email = selectedOption.dataset.email;
        if (email) {
            document.getElementById('email').value = email;
        }
    });

    // Adet artır
    function increaseQty(id) {
        const input = document.getElementById('product-qty-' + id);
        input.value = parseInt(input.value) + 1;
        calculateTotal();
    }

    // Adet azalt
    function decreaseQty(id) {
        const input = document.getElementById('product-qty-' + id);
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
            calculateTotal();
        }
    }

    // Yeni ürün ekle
    function addNewProduct() {
        productCount++;
        const tbody = document.getElementById('newlink');
            const newRow = document.createElement('tr');
        newRow.id = productCount;
        newRow.className = 'product';
        newRow.innerHTML = `
            <th scope="row" class="product-id">${productCount}</th>
            <td class="text-start">
                <div class="mb-2">
                    <input type="text" class="form-control bg-light border-0" id="productName-${productCount}" placeholder="Ürün Adı" required />
                </div>
                <textarea class="form-control bg-light border-0" id="productDetails-${productCount}" rows="2" placeholder="Ürün Detayları"></textarea>
            </td>
            <td>
                <input type="number" class="form-control product-price bg-light border-0" id="productRate-${productCount}" step="0.01" placeholder="0.00" required onchange="calculateTotal()" />
            </td>
            <td>
                <div class="input-step">
                    <button type="button" class='minus' onclick="decreaseQty(${productCount})">–</button>
                    <input type="number" class="product-quantity" id="product-qty-${productCount}" value="1" min="1" onchange="calculateTotal()">
                    <button type="button" class='plus' onclick="increaseQty(${productCount})">+</button>
                </div>
            </td>
            <td class="text-end">
                <div>
                    <input type="text" class="form-control bg-light border-0 product-line-price" id="productPrice-${productCount}" placeholder="${getCurrencySymbol()}0.00" readonly />
                </div>
            </td>
            <td class="product-removal">
                <a href="javascript:void(0)" class="btn btn-danger" onclick="removeProduct(${productCount})">Sil</a>
            </td>
        `;
        tbody.appendChild(newRow);
    }

    // Ürün sil
    function removeProduct(id) {
        const row = document.getElementById(id);
        if (row && document.querySelectorAll('.product').length > 1) {
            row.remove();
            calculateTotal();
        }
    }

    // Toplam hesapla
    function calculateTotal() {
        let subtotal = 0;
        const products = document.querySelectorAll('.product');
        
        products.forEach(product => {
            const id = product.id;
            const price = parseFloat(document.getElementById('productRate-' + id)?.value) || 0;
            const qty = parseInt(document.getElementById('product-qty-' + id)?.value) || 0;
            const lineTotal = price * qty;
            
            const linePriceInput = document.getElementById('productPrice-' + id);
            if (linePriceInput) {
                linePriceInput.value = getCurrencySymbol() + formatMoney(lineTotal);
            }
            
            subtotal += lineTotal;
        });

        const total = subtotal;
        const sym = getCurrencySymbol();

        document.getElementById('cart-subtotal').value = sym + formatMoney(subtotal);
        document.getElementById('cart-total').value = sym + formatMoney(total);
        document.getElementById('sourceAmount').value = total.toFixed(2);
    }

    // Form gönderimi
    document.getElementById('invoice_form').addEventListener('submit', async function(e) {
        e.preventDefault();

        // Form validasyonu
        if (!this.checkValidity()) {
            this.classList.add('was-validated');
            return;
        }

        const customerId = document.getElementById('choices-customer').value;
        const currency = document.getElementById('choices-currency').value;
        const sourceCurrency = document.getElementById('choices-source-currency').value;
        const sourceAmount = parseFloat(document.getElementById('sourceAmount').value) || 0;
        const orderName = document.getElementById('orderName').value;
        const email = document.getElementById('email').value;
        const callbackUrl = document.getElementById('callbackUrl').value;

        // Validasyon kontrolleri
        if (!customerId) {
            showError('Lütfen bir müşteri seçin.');
            return;
        }
        if (!currency) {
            showError('Lütfen bir para birimi seçin.');
            return;
        }
        if (!sourceCurrency) {
            showError('Lütfen gerçek para birimini seçin.');
            return;
        }
        if (sourceAmount <= 0) {
            showError('Tutar 0\'dan büyük olmalıdır.');
            return;
        }

        const products = getItems();

        // Sipariş numarası oluştur
        const orderNumber = 'ORD-' + Date.now();

        const isRecurring = document.querySelector('input[name="invoiceType"]:checked')?.value === 'recurring';
        const recurringDay = isRecurring ? parseInt(document.getElementById('recurringDay').value) : null;

        const invoiceData = {
            customerId: parseInt(customerId),
            currency: currency,
            sourceCurrency: sourceCurrency,
            sourceAmount: sourceAmount,
            orderNumber: orderNumber,
            orderName: orderName,
            email: email,
            callbackUrl: callbackUrl,
            isRecurring: isRecurring,
            recurringDay: recurringDay,
            invoiceItemsDto: products
        };
        
        // Loading modal göster
        const loadingEl = document.getElementById('loadingModal');
        const loadingModal = new bootstrap.Modal(loadingEl);
        loadingModal.show();

        // Modal'ı zorla kapat — DOM'dan temizle
        function forceHideLoading() {
            // Bootstrap instance varsa kapat
            const instance = bootstrap.Modal.getInstance(loadingEl);
            if (instance) {
                try { instance.hide(); } catch(e) {}
                try { instance.dispose(); } catch(e) {}
            }
            // DOM'dan zorla temizle
            loadingEl.classList.remove('show');
            loadingEl.style.display = 'none';
            loadingEl.setAttribute('aria-hidden', 'true');
            loadingEl.removeAttribute('aria-modal');
            loadingEl.removeAttribute('role');
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }

        try {
            const response = await fetch('/api/invoices/invoice-add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(invoiceData)
            });

            forceHideLoading();

            if (response.ok) {
                const result = await response.json();
                document.getElementById('successMessage').textContent = 'Fatura numarası: ' + orderNumber;
                const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();
            } else {
                let errorMsg = 'Fatura oluşturulurken bir hata oluştu.';
                try {
                    const error = await response.json();
                    if (error.message) {
                        errorMsg = error.message;
                    } else if (error.errors) {
                        // ASP.NET validation errors
                        const msgs = Object.values(error.errors).flat();
                        errorMsg = msgs.join('\n');
                    } else if (error.title) {
                        errorMsg = error.title;
                    }
                } catch(e) {}
                showError(errorMsg);
            }
        } catch (error) {
            console.error('Hata:', error);
            forceHideLoading();
            showError('Sunucu ile bağlantı kurulamadı. Lütfen tekrar deneyin.');
        }
    });

    // Yeni müşteri ekleme
    document.getElementById('newCustomerForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const errEl = document.getElementById('newCustApiError');
        errEl.classList.add('d-none');

        const payload = {
            firstName:   document.getElementById('newCustFirstName').value.trim(),
            lastName:    document.getElementById('newCustLastName').value.trim(),
            phone:       document.getElementById('newCustPhone').value.trim(),
            email:       document.getElementById('newCustEmail').value.trim(),
            companyName: document.getElementById('newCustCompany').value.trim(),
            telegram:    document.getElementById('newCustTelegram').value.trim(),
            skype:       document.getElementById('newCustSkype').value.trim()
        };

        if (!payload.firstName || !payload.lastName || !payload.phone) {
            errEl.textContent = 'Ad, Soyad ve Telefon zorunludur.';
            errEl.classList.remove('d-none');
            return;
        }

        try {
            const res = await fetch('/api/customers/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const c = await res.json();
                customers.push(c);
                const select = document.getElementById('choices-customer');
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = `${c.firstName} ${c.lastName}${c.companyName ? ' - ' + c.companyName : ''}`;
                opt.dataset.email = c.email || '';
                select.appendChild(opt);
                select.value = c.id;
                if (c.email) document.getElementById('email').value = c.email;
                bootstrap.Modal.getInstance(document.getElementById('newCustomerModal'))?.hide();
                this.reset();
            } else {
                const data = await res.json().catch(() => ({}));
                errEl.textContent = data.title || 'Müşteri eklenemedi.';
                errEl.classList.remove('d-none');
            }
        } catch {
            errEl.textContent = 'Sunucuya ulaşılamadı.';
            errEl.classList.remove('d-none');
        }
    });

    function showError(message) {
        document.getElementById('errorMessage').textContent = message;
        const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
        errorModal.show();
    }

    function getItems() {
        const items = [];

        document.querySelectorAll('tbody tr').forEach(row => {
            const nameInput = row.querySelector('[id^="productName-"]');
            if (!nameInput) return;

            const rawTotal = row.querySelector('[id^="productPrice-"]')?.value || '0';
            items.push({
                serviceName: nameInput.value,
                serviceDescription: row.querySelector('[id^="productDetails-"]')?.value || '',
                price: parseFloat(row.querySelector('[id^="productRate-"]')?.value) || 0,
                quantity: parseInt(row.querySelector('[id^="product-qty-"]')?.value) || 0,
                total: parseFloat(rawTotal.replace(/[^0-9.\-]/g, '')) || 0
            });
        });

        return items;
    }

</script>
}
