@{
    ViewBag.Title = "Müşteriler";
    Layout = "_Layout";
}

<div class="container-fluid">

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
            <h4 class="mb-sm-0">Müşteriler</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                    <li class="breadcrumb-item active">Müşteriler</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Özet Kartları -->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Toplam Müşteri</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0" id="stat-total">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-primary-subtle rounded fs-3"><i class="ri-team-line text-primary"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Şirket Müşterisi</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0" id="stat-company">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-success-subtle rounded fs-3"><i class="ri-building-line text-success"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Bireysel</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0" id="stat-individual">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-info-subtle rounded fs-3"><i class="ri-user-line text-info"></i></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1"><p class="text-uppercase fw-medium text-muted mb-0">Bu Ay Eklenen</p></div>
                </div>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <h4 class="fs-22 fw-semibold ff-secondary mb-0" id="stat-new">0</h4>
                    <div class="avatar-sm"><span class="avatar-title bg-warning-subtle rounded fs-3"><i class="ri-user-add-line text-warning"></i></span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Sol: Müşteri Listesi -->
    <div class="col-xxl-9 col-lg-8">
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0 flex-grow-1">
                        <i class="ri-contacts-line me-1"></i>Müşteri Listesi
                        <span class="badge bg-soft-secondary text-secondary ms-1 fs-12" id="filteredCount"></span>
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-soft-danger btn-sm d-none" id="remove-actions"><i class="ri-delete-bin-2-line me-1"></i>Seçilenleri Sil</button>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal"><i class="ri-add-line me-1"></i>Müşteri Ekle</button>
                    </div>
                </div>
            </div>
            <div class="card-body border-top border-bottom border-dashed py-3">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5 col-md-6">
                        <div class="search-box">
                            <input type="text" class="form-control bg-light border-light" id="searchInput" placeholder="Ad, şirket, email, telefon ara...">
                            <i class="ri-search-line search-icon"></i>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-6">
                        <select class="form-select bg-light border-light" id="filterType" onchange="applyFilters()">
                            <option value="">Tüm Müşteriler</option>
                            <option value="company">Şirket Müşterisi</option>
                            <option value="individual">Bireysel</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-3 col-6">
                        <select class="form-select bg-light border-light" id="sortBy" onchange="applyFilters()">
                            <option value="name">Ada Göre</option>
                            <option value="company">Şirkete Göre</option>
                            <option value="newest">En Yeni</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-3">
                        <button type="button" class="btn btn-light w-100" onclick="clearFilters()"><i class="ri-refresh-line me-1"></i>Sıfırla</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table align-middle table-hover table-nowrap mb-0" id="customerTable">
                        <thead class="table-light text-muted">
                            <tr>
                                <th style="width:40px;"><div class="form-check"><input class="form-check-input" type="checkbox" id="checkAll"></div></th>
                                <th>Müşteri</th>
                                <th>İletişim</th>
                                <th>Şirket</th>
                                <th style="width:100px;">Kanallar</th>
                                <th style="width:90px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="customerList">
                            @for (int i = 0; i < 5; i++)
                            {
                            <tr class="skeleton-row">
                                <td><div class="skeleton skeleton-text" style="width:18px;"></div></td>
                                <td><div class="d-flex align-items-center gap-2"><div class="skeleton skeleton-circle" style="width:36px;height:36px;"></div><div><div class="skeleton skeleton-text" style="width:120px;margin-bottom:4px;"></div><div class="skeleton skeleton-text-sm" style="width:80px;"></div></div></div></td>
                                <td><div class="skeleton skeleton-text-sm" style="width:130px;margin-bottom:4px;"></div><div class="skeleton skeleton-text-sm" style="width:90px;"></div></td>
                                <td><div class="skeleton skeleton-text" style="width:100px;"></div></td>
                                <td><div class="d-flex gap-1"><div class="skeleton" style="width:28px;height:28px;border-radius:50%;"></div><div class="skeleton" style="width:28px;height:28px;border-radius:50%;"></div></div></td>
                                <td><div class="skeleton skeleton-btn" style="width:60px;"></div></td>
                            </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-none text-center py-5" id="noresult">
                        <i class="ri-user-search-line" style="font-size:48px;color:#878a99;"></i>
                        <h5 class="mt-3">Müşteri Bulunamadı</h5>
                        <p class="text-muted mb-0">Filtreleri değiştirerek tekrar deneyin.</p>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3" id="paginationArea" style="display:none!important;">
                    <small class="text-muted" id="pageInfo"></small>
                    <div class="d-flex gap-1" id="pageBtns"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ: Detay Kartı -->
    <div class="col-xxl-3 col-lg-4">
        <div class="card" id="detailCard">
            <div class="card-body text-center pt-4">
                <div class="avatar-lg mx-auto mb-3">
                    <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-24" id="detail-avatar">?</span>
                </div>
                <h5 class="mb-1" id="detail-name">Müşteri Seçin</h5>
                <p class="text-muted fs-13 mb-0" id="detail-company">Listeden bir müşteriye tıklayın</p>
            </div>
            <div class="card-body border-top" id="detail-body" style="display:none;">
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-mail-line me-2 text-muted fs-16"></i>
                    <div>
                        <small class="text-muted d-block">E-posta</small>
                        <span class="fw-medium" id="detail-email">-</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-phone-line me-2 text-muted fs-16"></i>
                    <div>
                        <small class="text-muted d-block">Telefon</small>
                        <span class="fw-medium" id="detail-phone">-</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-building-line me-2 text-muted fs-16"></i>
                    <div>
                        <small class="text-muted d-block">Şirket</small>
                        <span class="fw-medium" id="detail-company2">-</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-telegram-line me-2 text-info fs-16"></i>
                    <div>
                        <small class="text-muted d-block">Telegram</small>
                        <span class="fw-medium" id="detail-telegram">-</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-0">
                    <i class="ri-skype-line me-2 text-primary fs-16"></i>
                    <div>
                        <small class="text-muted d-block">Skype</small>
                        <span class="fw-medium" id="detail-skype">-</span>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-0 mt-3">
                    <i class="ri-calendar-line me-2 text-muted fs-16"></i>
                    <div>
                        <small class="text-muted d-block">Doğum tarihi</small>
                        <span class="fw-medium" id="detail-dob">-</span>
                    </div>
                </div>
            </div>
            <div class="card-body border-top d-none" id="detail-ledger">
                <h6 class="text-muted text-uppercase fw-semibold mb-3"><i class="ri-file-list-3-line me-1"></i>Cari Hareketler</h6>
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <button type="button" class="btn btn-sm btn-success" id="btn-add-collection"><i class="ri-bank-card-2-line me-1"></i>Tahsilat Ekle</button>
                    <button type="button" class="btn btn-sm btn-outline-success" id="btn-add-refund"><i class="ri-arrow-left-right-line me-1"></i>Geri Ödeme Ekle</button>
                    <button type="button" class="btn btn-sm btn-danger" id="btn-add-expense"><i class="ri-money-dollar-circle-line me-1"></i>Masraf Ekle</button>
                </div>
                <div class="row g-2 mb-3" id="ledger-summary">
                    <div class="col-6"><div class="p-2 rounded bg-success-subtle text-success small"><strong>Tahsilat</strong><div id="ledger-tahsilat" class="fw-semibold"></div></div></div>
                    <div class="col-6"><div class="p-2 rounded bg-danger-subtle text-danger small"><strong>Geri Ödeme</strong><div id="ledger-refund" class="fw-semibold"></div></div></div>
                    <div class="col-6"><div class="p-2 rounded bg-warning-subtle text-warning small"><strong>Masraf</strong><div id="ledger-masraf" class="fw-semibold"></div></div></div>
                    <div class="col-6"><div class="p-2 rounded bg-primary-subtle text-primary small"><strong>Bakiye</strong><div id="ledger-bakiye" class="fw-semibold"></div></div></div>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <div class="small text-muted"><b id="ledger-toplam">0</b> (toplam)</div>
                    <select id="ledger-filter-type" class="form-select form-select-sm" style="width:auto;">
                        <option value="">Tüm Hareketler</option>
                        <option value="tahsilat">Tahsilat</option>
                        <option value="geri_odeme">Geri Ödeme</option>
                        <option value="masraf">Masraf</option>
                    </select>
                </div>
                <div class="table-responsive" style="max-height:280px;overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top"><tr><th>Tarih</th><th>Tür</th><th>Açıklama</th><th class="text-end">Tutar</th></tr></thead>
                        <tbody id="ledger-tbody"></tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-center d-none" id="detail-actions">
                <button class="btn btn-sm btn-soft-warning me-1" id="detail-edit-btn"><i class="ri-pencil-line me-1"></i>Düzenle</button>
                <button class="btn btn-sm btn-soft-danger" id="detail-delete-btn"><i class="ri-delete-bin-line me-1"></i>Sil</button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Tahsilat Ekle Modal -->
<div class="modal fade" id="collectionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success-subtle"><h5 class="modal-title">Tahsilat Ekle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="collection-customer-id" />
                <div class="mb-2"><label class="form-label">Tutar *</label><input type="number" step="0.01" id="collection-amount" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Para Birimi</label><select id="collection-currency" class="form-select"><option value="EUR">€ EUR</option><option value="USD">$ USD</option><option value="TRY">₺ TRY</option></select></div>
                <div class="mb-2"><label class="form-label">Açıklama</label><input type="text" id="collection-desc" class="form-control" placeholder="Tahsilat açıklaması" /></div>
                <div class="mb-0"><label class="form-label">Referans (Fatura no vb.)</label><input type="text" id="collection-ref" class="form-control" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button><button type="button" class="btn btn-success" id="collection-submit">Kaydet</button></div>
        </div>
    </div>
</div>

<!-- Geri Ödeme Ekle Modal -->
<div class="modal fade" id="refundModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success-subtle"><h5 class="modal-title">Geri Ödeme Ekle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="refund-customer-id" />
                <div class="mb-2"><label class="form-label">Tutar *</label><input type="number" step="0.01" id="refund-amount" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Para Birimi</label><select id="refund-currency" class="form-select"><option value="EUR">€ EUR</option><option value="USD">$ USD</option><option value="TRY">₺ TRY</option></select></div>
                <div class="mb-2"><label class="form-label">Açıklama</label><input type="text" id="refund-desc" class="form-control" placeholder="İade nedeni" /></div>
                <div class="mb-0"><label class="form-label">Referans (Fatura no vb.)</label><input type="text" id="refund-ref" class="form-control" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button><button type="button" class="btn btn-success" id="refund-submit">Kaydet</button></div>
        </div>
    </div>
</div>

<!-- Masraf Ekle Modal (Müşteriye atfedilen) -->
<div class="modal fade" id="expenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger-subtle"><h5 class="modal-title">Masraf Ekle</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="expense-customer-id" />
                <div class="mb-2"><label class="form-label">Tutar *</label><input type="number" step="0.01" id="expense-amount" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Para Birimi</label><select id="expense-currency" class="form-select"><option value="EUR">€ EUR</option><option value="USD">$ USD</option><option value="TRY">₺ TRY</option></select></div>
                <div class="mb-2"><label class="form-label">Kategori</label><select id="expense-category" class="form-select"><option value="6">Diğer</option><option value="3">Sunucu Gideri</option><option value="4">Ofis Gideri</option></select></div>
                <div class="mb-0"><label class="form-label">Açıklama</label><input type="text" id="expense-desc" class="form-control" placeholder="Masraf açıklaması" /></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button><button type="button" class="btn btn-danger" id="expense-submit">Kaydet</button></div>
        </div>
    </div>
</div>

<!-- Müşteri Ekle Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header bg-primary-subtle">
                <h5 class="modal-title"><i class="ri-user-add-line me-2"></i>Yeni Müşteri Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addForm" autocomplete="off">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Ad <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" id="add-firstName" class="form-control ps-5" placeholder="Müşteri adı" required>
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-user-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Soyad <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" id="add-lastName" class="form-control ps-5" placeholder="Müşteri soyadı" required>
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-user-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-medium">Şirket Adı</label>
                            <div class="position-relative">
                                <input type="text" id="add-companyName" class="form-control ps-5" placeholder="Şirket adı (opsiyonel)">
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-building-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">E-posta <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="email" id="add-email" class="form-control ps-5" placeholder="ornek@email.com" required>
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-mail-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Telefon <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="tel" id="add-phone" class="form-control ps-5" placeholder="+90 5XX XXX XX XX" required>
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-phone-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Telegram</label>
                            <div class="position-relative">
                                <input type="text" id="add-telegram" class="form-control ps-5" placeholder="kullanici_adi">
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-info"><i class="ri-telegram-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Skype</label>
                            <div class="position-relative">
                                <input type="text" id="add-skype" class="form-control ps-5" placeholder="Skype kullanıcı adı">
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-primary"><i class="ri-skype-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Doğum tarihi</label>
                            <div class="position-relative">
                                <input type="date" id="add-dateOfBirth" class="form-control ps-5">
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-calendar-line"></i></span>
                            </div>
                            <small class="text-muted">Toplu e-posta &quot;bugün doğanlar&quot; için (opsiyonel)</small>
                        </div>
                    </div>
                    <div id="addError" class="alert alert-danger mt-3 d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary" id="addBtn">
                        <span id="addBtnText"><i class="ri-add-line me-1"></i>Müşteri Ekle</span>
                        <span id="addBtnSpinner" class="d-none"><span class="spinner-border spinner-border-sm me-1"></span>Ekleniyor...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Müşteri Düzenle Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            <div class="modal-header bg-warning-subtle">
                <h5 class="modal-title"><i class="ri-pencil-line me-2"></i>Müşteri Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" autocomplete="off">
                <div class="modal-body">
                    <input type="hidden" id="edit-id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Ad <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" id="edit-firstName" class="form-control ps-5" required>
                                <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"><i class="ri-user-line"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Soyad <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" id="edit-lastName" class="form-control ps-5" required>
